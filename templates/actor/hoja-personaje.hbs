{{!--
  Plantilla de la Hoja de Personaje ApplicationV2 con Raza, Origen, Clase, Cartas (pestaña Principal), Equipo y Raza (pestañas propias).
  Iconografía (v0.9.0): solo iconos Font Awesome y símbolos tipográficos, sin emojis.
  Características: FISC fa-hand-fist · CONS fa-eye · SOC fa-masks-theater · MIST fa-moon.
--}}
<div class="cyd-hoja-contenedor">

  {{!-- ================= 1. CABECERA Y TRASFONDO (RAZA, ORIGEN, CLASE) ================= --}}
  <header class="cyd-cabecera">
    <div class="cyd-retrato">
      <img class="cyd-avatar" src="{{actor.img}}" alt="{{actor.name}}" data-action="verImagen" data-tooltip="Ver imagen a tamaño completo" />
      <div class="cyd-retrato-botones">
        {{#if retrato.puedeEditar}}
          <button type="button" class="cyd-btn-retrato" data-action="editarImagen" data-tooltip="Editar imagen" aria-label="Editar imagen"><i class="fa-solid fa-pen-to-square"></i></button>
        {{/if}}
        {{#if retrato.tieneToken}}
          <button type="button" class="cyd-btn-retrato" data-action="configurarToken" data-tooltip="Configurar Token" aria-label="Configurar Token"><i class="fa-solid fa-circle-user"></i></button>
        {{/if}}
      </div>
    </div>

    <div class="cyd-cabecera-principal">
      <div class="cyd-fila-titulo">
        <input type="text" name="name" value="{{actor.name}}" class="cyd-nombre-actor" placeholder="Nombre del Personaje" />
      </div>

      {{!-- Ranuras de Trasfondo: Raza, Origen y Clase --}}
      <div class="cyd-trasfondo-barra">
        <div class="cyd-slot-trasfondo" data-tooltip="{{#if itemRaza}}Rasgo: {{itemRaza.system.rasgoRacial}}<br>{{itemRaza.system.descripcion}}{{else}}Define la Raza del personaje{{/if}}">
          <span class="cyd-slot-etiqueta"><i class="fa-solid fa-dna"></i> Raza</span>
          {{#if itemRaza}}
            <strong data-action="editarItem" data-item-id="{{itemRaza.id}}" class="cyd-link-item">{{itemRaza.name}}</strong>
            <button type="button" class="cyd-btn-mini cyd-btn-icono cyd-peligro" data-action="eliminarItem" data-item-id="{{itemRaza.id}}" data-tooltip="Quitar Raza"><i class="fa-solid fa-xmark"></i></button>
          {{else}}
            <button type="button" class="cyd-btn-mini" data-action="crearItem" data-tipo="raza"><i class="fa-solid fa-plus"></i> Elegir</button>
          {{/if}}
        </div>

        <div class="cyd-slot-trasfondo" data-tooltip="{{#if itemOrigen}}Beneficio: {{itemOrigen.system.beneficioTrasfondo}}<br>{{itemOrigen.system.descripcion}}{{else}}Define el Origen del personaje{{/if}}">
          <span class="cyd-slot-etiqueta"><i class="fa-solid fa-compass"></i> Origen</span>
          {{#if itemOrigen}}
            <strong data-action="editarItem" data-item-id="{{itemOrigen.id}}" class="cyd-link-item">{{itemOrigen.name}}</strong>
            <button type="button" class="cyd-btn-mini cyd-btn-icono cyd-peligro" data-action="eliminarItem" data-item-id="{{itemOrigen.id}}" data-tooltip="Quitar Origen"><i class="fa-solid fa-xmark"></i></button>
          {{else}}
            <button type="button" class="cyd-btn-mini" data-action="crearItem" data-tipo="origen"><i class="fa-solid fa-plus"></i> Elegir</button>
          {{/if}}
        </div>

        <div class="cyd-slot-trasfondo" data-tooltip="{{#if itemClase}}{{itemClase.name}} · Nivel {{itemClase.system.nivel}}{{else}}Define la Clase del personaje{{/if}}">
          <span class="cyd-slot-etiqueta"><i class="fa-solid fa-scroll"></i> Clase</span>
          {{#if itemClase}}
            <strong data-action="editarItem" data-item-id="{{itemClase.id}}" class="cyd-link-item">
              {{itemClase.name}} · Nv. {{itemClase.system.nivel}}
            </strong>
            {{#if subidaNivel}}
              <button type="button" class="cyd-btn-mini cyd-btn-icono" data-action="subirNivel" data-tooltip="Subir a Nivel {{subidaNivel.nivelDestino}}" aria-label="Subir de Nivel"><i class="fa-solid fa-angles-up"></i></button>
            {{/if}}
            <button type="button" class="cyd-btn-mini cyd-btn-icono cyd-peligro" data-action="eliminarItem" data-item-id="{{itemClase.id}}" data-tooltip="Quitar Clase"><i class="fa-solid fa-xmark"></i></button>
          {{else}}
            <button type="button" class="cyd-btn-mini" data-action="crearItem" data-tipo="clase"><i class="fa-solid fa-plus"></i> Elegir</button>
          {{/if}}
        </div>
      </div>
    </div>
  </header>

  {{!-- Pestañas (v0.13.1): navegación nativa de ApplicationV2 (`static TABS`, acción "tab") --}}
  <nav class="sheet-tabs tabs cyd-pestanas" aria-roledescription="Pestañas de la ficha">
    <a data-action="tab" data-group="primary" data-tab="principal" class="{{tabs.principal.cssClass}}"><i class="fa-solid fa-id-card" inert></i> <span>Principal</span></a>
    <a data-action="tab" data-group="primary" data-tab="equipo" class="{{tabs.equipo.cssClass}}"><i class="fa-solid fa-box-open" inert></i> <span>Equipo</span></a>
    <a data-action="tab" data-group="primary" data-tab="raza" class="{{tabs.raza.cssClass}}"><i class="fa-solid fa-dna" inert></i> <span>Raza</span></a>
  </nav>


  <main class="cyd-cuerpo-hoja">

  <section class="tab cyd-pestana-principal {{tabs.principal.cssClass}}" data-group="primary" data-tab="principal">
  {{!-- ================= 2. LAYOUT DOS COLUMNAS: ATRIBUTOS IZQUIERDA | CONTENIDO DERECHA ================= --}}
  <div class="cyd-layout-dos-columnas cyd-layout-sidebar-compacta">

    {{!-- COLUMNA IZQUIERDA: RECURSOS, CARACTERÍSTICAS Y MOVIMIENTO ================= --}}
    <aside class="cyd-sidebar-atributos cyd-sidebar-compacta">
      {{!-- Recursos vitales (v0.13.1: rejilla compacta encima de las Características; Salud ocupa la fila) ================= --}}
      <div class="cyd-rejilla-sidebar cyd-rejilla-recursos cyd-recursos-vitales">
        <div class="cyd-recurso-caja cyd-ocupa-fila{{#if system.agotamiento.efectos.saludMitad}} cyd-afectado-agotamiento{{/if}}" data-tooltip="Base: {{system.salud.max}} | Físico: +{{system.salud.bonoFisico}} | Otros: +{{system.salud.bonoOtros}}{{#if system.agotamiento.efectos.saludMitad}} | Agotamiento: {{system.salud.maxSinAgotamiento}} ÷ 2{{/if}} | Total: {{system.salud.maxTotal}}">
          <span class="cyd-recurso-titulo"><i class="fa-solid fa-heart-pulse"></i> Salud</span>
          <div class="cyd-recurso-inputs">
            <input type="number" name="system.salud.value" value="{{system.salud.value}}" aria-label="Salud actual" />
            <span class="cyd-valor-sep">/</span>
            <span class="cyd-valor-grande">{{system.salud.maxTotal}}</span>{{#if system.agotamiento.efectos.saludMitad}} <i class="fa-solid fa-hourglass-half cyd-icono-agotamiento" data-tooltip="Reducido a la mitad por Agotamiento"></i>{{/if}}
          </div>
          <meter class="cyd-barra-salud {{barraSalud.estado}}" min="0" max="{{barraSalud.maximo}}" value="{{barraSalud.valor}}" aria-label="Salud" data-tooltip="Salud: {{barraSalud.valor}} / {{barraSalud.maximo}} ({{barraSalud.porcentaje}} %)"></meter>
        </div>

        <div class="cyd-recurso-caja" data-tooltip="Defensa Base: {{system.defensa}} | Bono Equipo/Raza: +{{system.bonificadorDefensa}}{{#if system.bonoDefensaRaza}} (Rasgo racial: +{{system.bonoDefensaRaza}}){{/if}} | Total: {{system.defensaTotal}}">
          <span class="cyd-recurso-titulo"><i class="fa-solid fa-shield-halved"></i> Defensa</span>
          <div class="cyd-recurso-inputs">
            <input type="number" name="system.defensa" value="{{system.defensa}}" min="0" aria-label="Defensa base" />
            <span class="cyd-valor-sep">→</span>
            <span class="cyd-valor-grande">{{system.defensaTotal}}</span>
          </div>
        </div>

        <div class="cyd-recurso-caja{{#if system.agotamiento.efectos.manoMitad}} cyd-afectado-agotamiento{{/if}}{{#if system.manoMitadPorSangreFria}} cyd-afectado-agotamiento{{/if}}" data-tooltip="Mano Máx. · Base: {{system.manoConfig.base}} | Nivel Clase: +{{system.manoConfig.bonificadorClase}} | Raza/Origen/Equipo: +{{system.manoConfig.bonificadorObjetos}}{{#if system.agotamiento.efectos.manoMitad}} | Agotamiento: {{system.limiteManoSinAgotamiento}} ÷ 2{{/if}}{{#if system.manoMitadPorSangreFria}} | Sangre fría: ÷ 2{{/if}}">
          <span class="cyd-recurso-titulo"><i class="fa-solid fa-hand"></i> Mano</span>
          <div class="cyd-recurso-inputs">
            <span class="cyd-valor-grande">{{#if contadoresPilas}}{{contadoresPilas.manoActual}}{{else}}0{{/if}}</span>
            <span class="cyd-valor-sep">/</span>
            <span class="cyd-valor-grande">{{system.limiteMano}}</span>{{#if system.agotamiento.efectos.manoMitad}} <i class="fa-solid fa-hourglass-half cyd-icono-agotamiento" data-tooltip="Reducido a la mitad por Agotamiento"></i>{{/if}}{{#if system.manoMitadPorSangreFria}} <i class="fa-solid fa-temperature-half cyd-icono-agotamiento" data-tooltip="Reducido a la mitad por Sangre fría (expuesta a los elementos)"></i>{{/if}}
          </div>
        </div>
      </div>

      {{!-- Características en rejilla 2×2 (abreviatura visible; nombre completo y desglose en el tooltip) --}}
      <div class="cyd-cabecera-seccion">
        <h3><i class="fa-solid fa-star-of-life"></i> Características</h3>
      </div>
      <div class="cyd-rejilla-sidebar cyd-rejilla-caracteristicas">
        <div class="cyd-atributo-tarjeta" data-tooltip="Físico · Base: {{system.caracteristicas.fisico}} | Bono Raza/Origen/Equipo: {{system.bonificadoresCaracteristicas.fisico}} | Dados: {{system.caracteristicasTotales.fisico}}">
          <div class="cyd-atributo-cabecera">
            <span class="cyd-atributo-sello"><i class="fa-solid fa-hand-fist"></i></span>
            <span class="cyd-atributo-nombre">FISC</span>
          </div>
          <div class="cyd-atributo-fila-valores">
            <input type="number" name="system.caracteristicas.fisico" value="{{system.caracteristicas.fisico}}" min="1" max="10" aria-label="Físico base" />
            <span class="cyd-atributo-total" aria-label="Dados totales a lanzar"><i class="fa-solid fa-dice-d20"></i>{{system.caracteristicasTotales.fisico}}</span>
          </div>
        </div>

        <div class="cyd-atributo-tarjeta" data-tooltip="Consciencia · Base: {{system.caracteristicas.consciencia}} | Bono Raza/Origen/Equipo: {{system.bonificadoresCaracteristicas.consciencia}} | Dados: {{system.caracteristicasTotales.consciencia}}">
          <div class="cyd-atributo-cabecera">
            <span class="cyd-atributo-sello"><i class="fa-solid fa-eye"></i></span>
            <span class="cyd-atributo-nombre">CONS</span>
          </div>
          <div class="cyd-atributo-fila-valores">
            <input type="number" name="system.caracteristicas.consciencia" value="{{system.caracteristicas.consciencia}}" min="1" max="10" aria-label="Consciencia base" />
            <span class="cyd-atributo-total" aria-label="Dados totales a lanzar"><i class="fa-solid fa-dice-d20"></i>{{system.caracteristicasTotales.consciencia}}</span>
          </div>
        </div>

        <div class="cyd-atributo-tarjeta" data-tooltip="Social · Base: {{system.caracteristicas.social}} | Bono Raza/Origen/Equipo: {{system.bonificadoresCaracteristicas.social}} | Dados: {{system.caracteristicasTotales.social}}">
          <div class="cyd-atributo-cabecera">
            <span class="cyd-atributo-sello"><i class="fa-solid fa-masks-theater"></i></span>
            <span class="cyd-atributo-nombre">SOC</span>
          </div>
          <div class="cyd-atributo-fila-valores">
            <input type="number" name="system.caracteristicas.social" value="{{system.caracteristicas.social}}" min="1" max="10" aria-label="Social base" />
            <span class="cyd-atributo-total" aria-label="Dados totales a lanzar"><i class="fa-solid fa-dice-d20"></i>{{system.caracteristicasTotales.social}}</span>
          </div>
        </div>

        <div class="cyd-atributo-tarjeta" data-tooltip="Misticismo · Base: {{system.caracteristicas.misticismo}} | Bono Raza/Origen/Equipo: {{system.bonificadoresCaracteristicas.misticismo}} | Dados: {{system.caracteristicasTotales.misticismo}}">
          <div class="cyd-atributo-cabecera">
            <span class="cyd-atributo-sello"><i class="fa-solid fa-moon"></i></span>
            <span class="cyd-atributo-nombre">MIST</span>
          </div>
          <div class="cyd-atributo-fila-valores">
            <input type="number" name="system.caracteristicas.misticismo" value="{{system.caracteristicas.misticismo}}" min="1" max="10" aria-label="Misticismo base" />
            <span class="cyd-atributo-total" aria-label="Dados totales a lanzar"><i class="fa-solid fa-dice-d20"></i>{{system.caracteristicasTotales.misticismo}}</span>
          </div>
        </div>
      </div>

      {{!-- ================= MOVIMIENTO Y TAMAÑO (v0.13.1: fila compacta bajo las Características) ================= --}}
      <div class="cyd-rejilla-sidebar cyd-rejilla-movimiento">
        <div class="cyd-recurso-caja{{#if system.agotamiento.efectos.velocidadMitad}} cyd-afectado-agotamiento{{/if}}" data-tooltip="Movimiento · Base editable / Total. Total = Base + (Físico Total × 5) metros{{#if system.agotamiento.efectos.velocidadMitad}} | Agotamiento: {{system.movimiento.maxSinAgotamiento}} ÷ 2{{/if}}">
          <span class="cyd-recurso-titulo"><i class="fa-solid fa-person-running"></i> Mov. (m)</span>
          <div class="cyd-recurso-inputs">
            <input type="number" name="system.movimiento.base" value="{{system.movimiento.base}}" min="0" aria-label="Movimiento base" />
            <span class="cyd-valor-sep">/</span>
            <span class="cyd-valor-grande">{{system.movimiento.max}}</span>{{#if system.agotamiento.efectos.velocidadMitad}} <i class="fa-solid fa-hourglass-half cyd-icono-agotamiento" data-tooltip="Reducido a la mitad por Agotamiento"></i>{{/if}}
          </div>
        </div>
        <div class="cyd-recurso-caja" data-tooltip="Categoría de tamaño de la criatura">
          <span class="cyd-recurso-titulo"><i class="fa-solid fa-ruler-vertical"></i> Tamaño</span>
          <select name="system.categoriaTamano" aria-label="Tamaño">
            <option value="Diminuto" {{#if (eq system.categoriaTamano "Diminuto")}}selected{{/if}}>Diminuto</option>
            <option value="Pequeño" {{#if (eq system.categoriaTamano "Pequeño")}}selected{{/if}}>Pequeño</option>
            <option value="Mediano" {{#if (eq system.categoriaTamano "Mediano")}}selected{{/if}}>Mediano</option>
            <option value="Grande" {{#if (eq system.categoriaTamano "Grande")}}selected{{/if}}>Grande</option>
            <option value="Enorme" {{#if (eq system.categoriaTamano "Enorme")}}selected{{/if}}>Enorme</option>
          </select>
        </div>
      </div>
    </aside>

    {{!-- COLUMNA DERECHA: AGOTAMIENTO, RASGOS A MANO, PILAS, CARTAS, EQUIPO ================= --}}
    <section class="cyd-contenido-derecha">

      {{!-- Agotamiento (v0.12.0): barra de 8 segmentos (clic para fijar el nivel) y consecuencias en vigor ================= --}}
      <section class="cyd-panel cyd-panel-agotamiento{{#if agotamiento.muerto}} cyd-muerto{{/if}}">
        <div class="cyd-cabecera-seccion">
          <h3 data-tooltip="{{agotamiento.tooltipHtml}}" data-tooltip-class="cyd-tooltip"><i class="fa-solid fa-hourglass-half"></i> Agotamiento</h3>
        </div>
        <div class="cyd-barra-agotamiento{{#if esPropietario}} cyd-editable{{/if}}" role="meter" aria-label="Agotamiento" aria-valuemin="0" aria-valuemax="{{agotamiento.maximo}}" aria-valuenow="{{agotamiento.nivel}}">
          {{#each agotamiento.segmentos as |seg|}}
            <span class="cyd-segmento-agotamiento{{#if seg.activo}} cyd-lleno{{/if}}{{#if seg.esMuerte}} cyd-segmento-muerte{{/if}}"
                  {{#if @root.esPropietario}}data-action="fijarAgotamiento" data-nivel="{{seg.nivel}}" tabindex="0"{{/if}}
                  data-tooltip="Nivel {{seg.nivel}}: {{seg.texto}}"></span>
          {{/each}}
        </div>
        {{#if agotamiento.nivel}}
          <ul class="cyd-lista-agotamiento">
            {{#each agotamiento.activos as |efecto|}}
              <li><i class="fa-solid {{efecto.icono}}"></i> <strong>{{efecto.nivel}}.</strong> {{efecto.texto}}</li>
            {{/each}}
          </ul>
        {{else}}
          <p class="cyd-agotamiento-vacio">Sin Agotamiento.</p>
        {{/if}}
        {{!-- (v0.17.0) Potens Mystica: Mal de ojo y Destino sellado sobre este Actor --}}
        {{#if estadosMisticos}}
          <div class="cyd-estado-acciones cyd-estados-misticos">
            {{#if estadosMisticos.malDeOjo}}
              <span class="cyd-chip-estado cyd-bloqueado" data-tooltip="Mal de ojo{{#if estadosMisticos.malDeOjo.origen}} de {{estadosMisticos.malDeOjo.origen}}{{/if}}: tus cartas de Misticismo bajan una categoría de dado (una carta d4 da automáticamente 1). En combate pierde un turno al final de cada uno de tus turnos">
                <i class="fa-solid fa-eye-slash"></i> Mal de ojo · {{estadosMisticos.malDeOjo.turnos}} turno(s)
              </span>
              {{#if esPropietario}}<button type="button" class="cyd-btn-icono cyd-peligro" data-action="retirarEstadoMistico" data-estado="malDeOjo" data-tooltip="Retirar el Mal de ojo"><i class="fa-solid fa-xmark"></i></button>{{/if}}
            {{/if}}
            {{#if estadosMisticos.destinoSellado}}
              <span class="cyd-chip-estado cyd-bloqueado" data-tooltip="Destino sellado{{#if estadosMisticos.destinoSellado.origen}} por {{estadosMisticos.destinoSellado.origen}}{{/if}}: tu siguiente acción debe ser de {{estadosMisticos.destinoSellado.caracteristica}}; después el efecto termina">
                <i class="fa-solid fa-lock"></i> Destino sellado · {{estadosMisticos.destinoSellado.palo}}
              </span>
              {{#if esPropietario}}<button type="button" class="cyd-btn-icono cyd-peligro" data-action="retirarEstadoMistico" data-estado="destinoSellado" data-tooltip="Retirar el destino sellado"><i class="fa-solid fa-xmark"></i></button>{{/if}}
            {{/if}}
          </div>
        {{/if}}
      </section>

      {{!-- ================= 3. RASGOS RACIALES A MANO (v0.13.1) =================
           Solo los rasgos con control o estado en juego (`aMano` en RAZAS_BASE); los
           textos completos están en la pestaña Raza. --}}
      {{#if rasgosRaza.aMano.length}}
      <section class="cyd-panel cyd-panel-rasgos-raza cyd-rasgos-a-mano">
        <div class="cyd-cabecera-seccion">
          <h3><i class="fa-solid fa-dna"></i> Rasgos Raciales · {{rasgosRaza.nombre}}</h3>
          <a class="cyd-enlace-pestana" data-action="tab" data-group="primary" data-tab="raza" data-tooltip="Ver todos los rasgos de la raza"><i class="fa-solid fa-book-open" inert></i> Ver todos</a>
        </div>
        <ul class="cyd-lista-rasgos">
          {{#each rasgosRaza.aMano as |rasgo|}}
            <li class="cyd-rasgo">
              <div class="cyd-rasgo-cabecera">
                <strong data-tooltip="{{rasgo.texto}}{{#if rasgo.auto}}<br><em>{{rasgo.auto}}</em>{{/if}}" data-tooltip-class="cyd-tooltip"><i class="fa-solid {{rasgo.icono}}"></i> {{rasgo.nombre}}</strong>
                <span class="cyd-rasgo-tipo">{{#if rasgo.esDesventaja}}Desventaja{{else}}Beneficio{{/if}}</span>
                {{#if (eq rasgo.clave "esperaUnMomento")}}
                  <label class="cyd-rasgo-control" data-tooltip="Se recarga al descansar. Úsalo desde el botón de tus tiradas en el chat.">
                    <input type="checkbox" name="system.rasgosRaza.esperaUnMomentoUsado" {{checked @root.system.rasgosRaza.esperaUnMomentoUsado}} {{#unless @root.esPropietario}}disabled{{/unless}} /> Usado
                  </label>
                {{/if}}
                {{#if (eq rasgo.clave "tradicionAlquimica")}}
                  {{#if @root.esPropietario}}
                    <button type="button" class="cyd-btn-mini" data-action="usarAlquimia" {{#if @root.system.rasgosRaza.alquimiaUsada}}disabled{{/if}} data-tooltip="Cura {{@root.system.nivelEfectivo}} de Salud a ti o al objetivo marcado (T)"><i class="fa-solid fa-flask"></i> Preparar</button>
                  {{/if}}
                  <label class="cyd-rasgo-control" data-tooltip="Se recarga con un descanso cómodo (1 vez al día).">
                    <input type="checkbox" name="system.rasgosRaza.alquimiaUsada" {{checked @root.system.rasgosRaza.alquimiaUsada}} {{#unless @root.esPropietario}}disabled{{/unless}} /> Usado hoy
                  </label>
                {{/if}}
                {{#if (eq rasgo.clave "queMeDaAlgo")}}
                  {{#if @root.system.queMeDaAlgoActivo}}
                    <span class="cyd-rasgo-estado cyd-activo"><i class="fa-solid fa-circle-check"></i> Activo</span>
                  {{else}}
                    <span class="cyd-rasgo-estado">Inactivo</span>
                  {{/if}}
                {{/if}}
                {{#if (eq rasgo.clave "sangreFria")}}
                  <label class="cyd-rasgo-control" data-tooltip="Mientras esté activo, la Mano Máx. se reduce a la mitad.">
                    <input type="checkbox" name="system.rasgosRaza.expuestoElementos" {{checked @root.system.rasgosRaza.expuestoElementos}} {{#unless @root.esPropietario}}disabled{{/unless}} /> Expuesta a los elementos
                  </label>
                {{/if}}
              </div>
            </li>
          {{/each}}
        </ul>
      </section>
      {{/if}}

    {{#unless pilasInicializadas}}
      <div class="cyd-aviso-inicializar">
        <p>Este personaje aún no tiene sus pilas de cartas vinculadas en el mundo.</p>
        {{#if esPropietario}}
          <button type="button" class="cyd-btn-primario" data-action="inicializarPilas">
            <i class="fa-solid fa-wand-sparkles"></i> Elegir Clase e Inicializar las Pilas de Cartas
          </button>
        {{/if}}
      </div>
    {{else}}

      {{!-- ================= 4. CONTROLES DE TURNO Y PILAS ================= --}}
      <section class="cyd-panel-controles">
        <div class="cyd-cabecera-seccion">
          <h3><i class="fa-solid fa-layer-group"></i> Mazo y Pilas</h3>
          {{#if esPropietario}}
            {{#unless itemClase}}
              <button type="button" class="cyd-btn-mini" data-action="inicializarPilas" data-tooltip="Asistente de Clase: elige tu Clase y Trinket, y genera tu Mazo inicial">
                <i class="fa-solid fa-wand-sparkles"></i> Asistente de Clase
              </button>
            {{/unless}}
          {{/if}}
        </div>

        {{#if esPropietario}}
          <div class="cyd-acciones-turno">
            <button type="button" data-action="robarTurno"><i class="fa-solid fa-clone"></i> Inicio de Turno</button>
            <button type="button" data-action="robarTrinket"><i class="fa-solid fa-gem"></i> Robar Trinket</button>
            <button type="button" data-action="finCombate"><i class="fa-solid fa-rotate"></i> Fin de Combate</button>
            <button type="button" data-action="descansar"><i class="fa-solid fa-campground"></i> Descansar</button>
          </div>
          {{!-- (v0.14.0) Estado de acción: combate, reacción y acción fuera de combate (mini turno) --}}
          <div class="cyd-estado-acciones">
            <span class="cyd-chip-estado{{#if estadoAcciones.enCombate}} cyd-activo{{/if}}" data-tooltip="{{#if estadoAcciones.enCombate}}En combate: usa las cartas de tu mano; robas al inicio de tu turno{{else}}Fuera de combate: roba el doble de tu Mano Máx. para cada acción{{/if}}">
              <i class="fa-solid {{#if estadoAcciones.enCombate}}fa-khanda{{else}}fa-person-walking{{/if}}"></i> {{#if estadoAcciones.enCombate}}En combate{{else}}Fuera de combate{{/if}}
            </span>
            {{#if estadoAcciones.sinReacciones}}
              <span class="cyd-chip-estado cyd-bloqueado" data-tooltip="Agotamiento 4+: no puede realizar reacciones (solo como excepción)"><i class="fa-solid fa-ban"></i> Sin reacciones</span>
            {{else if estadoAcciones.reaccionUsada}}
              <span class="cyd-chip-estado cyd-bloqueado" data-action="restablecerReaccion" data-tooltip="Reacción usada: se recupera al inicio de tu turno. Clic para recuperarla ahora (excepción)"><i class="fa-solid fa-bolt"></i> Reacción usada</span>
            {{else}}
              <span class="cyd-chip-estado" data-tooltip="Puedes realizar una reacción hasta que vuelva a ser tu turno"><i class="fa-solid fa-bolt"></i> Reacción disponible</span>
            {{/if}}
            {{#if estadoAcciones.miniTurno}}
              <span class="cyd-chip-estado cyd-activo" data-tooltip="Cada mano robada (tantas cartas como tu Mano Máx.) equivale a un turno de tiempo">
                <i class="fa-solid fa-stopwatch"></i> {{#if estadoAcciones.miniTurno.esReaccion}}Reacción{{else}}Acción{{/if}} fuera de combate · {{estadoAcciones.miniTurno.manos}} manos
              </span>
            {{/if}}
          </div>
          {{!-- (v0.16.0) Alta Scentia: Visión del futuro, Artilugio de primera y Tiempo embotellado --}}
          {{#if altaScentia}}
          <div class="cyd-estado-acciones cyd-alta-scentia">
            {{#if altaScentia.verPrimera}}
              {{#if altaScentia.primeraCarta}}
                <span class="cyd-chip-estado cyd-activo" data-tooltip="Visión del futuro: la primera carta de tu Mazo (solo la ves tú y el Master). Tras una tirada de CONS o MIST, el chat te deja descartarla">
                  <i class="fa-solid fa-eye"></i> Primera carta: <strong>{{altaScentia.primeraCarta.nombre}}</strong> · {{altaScentia.primeraCarta.palo}} {{altaScentia.primeraCarta.tipoDado}}
                </span>
              {{else}}
                <span class="cyd-chip-estado" data-tooltip="Visión del futuro: no quedan cartas en tu Mazo"><i class="fa-solid fa-eye"></i> Mazo vacío</span>
              {{/if}}
            {{/if}}
            {{#if altaScentia.artilugio}}
              <span class="cyd-chip-estado{{#if altaScentia.artilugioEnJuego}} cyd-activo{{/if}}" data-tooltip="{{altaScentia.artilugio.texto}}{{#if altaScentia.artilugio.auto}}<br><em>{{altaScentia.artilugio.auto}}</em>{{/if}}" data-tooltip-class="cyd-tooltip">
                <i class="fa-solid {{altaScentia.artilugio.icono}}"></i> {{altaScentia.artilugio.nombre}}
              </span>
              {{#if altaScentia.monoculo}}
                <button type="button" class="cyd-btn-mini" data-action="usarMonoculo" data-tooltip="Marca con T un Token y mira en privado la carta superior de su Mazo"><i class="fa-solid fa-magnifying-glass"></i> Monóculo</button>
              {{/if}}
            {{/if}}
            {{#if altaScentia.tiempoEmbotellado}}
              <span class="cyd-chip-estado cyd-activo" data-tooltip="Tiempo embotellado: al hacer otra tirada se te preguntará qué dados sustituir por estos valores (cada uno, una vez)">
                <i class="fa-solid fa-hourglass-start"></i> Embotellado: [{{#each altaScentia.tiempoEmbotellado.valores as |v|}}{{#unless @first}}, {{/unless}}{{v}}{{/each}}] {{altaScentia.tiempoEmbotellado.tipoDado}}
              </span>
              <button type="button" class="cyd-btn-icono cyd-peligro" data-action="descartarTiempoEmbotellado" data-tooltip="Descartar los dados embotellados"><i class="fa-solid fa-xmark"></i></button>
            {{/if}}
          </div>
          {{/if}}
          <div class="cyd-acciones-turno cyd-cols-2">
            {{#if estadoAcciones.miniTurno}}
              {{#if estadoAcciones.miniTurno.esReaccion}}
              <span class="cyd-chip-estado cyd-bloqueado" data-tooltip="Una reacción fuera de combate solo roba una mano: si no tienes la carta adecuada, falla"><i class="fa-solid fa-ban"></i> Sin más robos</span>
              {{else}}
              <button type="button" data-action="otraManoMiniTurno" data-tooltip="Roba tantas cartas como tu Mano Máx.: la acción tarda un turno más"><i class="fa-solid fa-clone"></i> Robar otra mano</button>
              {{/if}}
              <button type="button" data-action="terminarMiniTurno" data-tooltip="{{#if estadoAcciones.miniTurno.esReaccion}}Termina la reacción; si no has usado ninguna carta, falla{{else}}Termina la acción y decide qué hacer con las cartas que quedan en la mano{{/if}}"><i class="fa-solid fa-hourglass-end"></i> {{#if estadoAcciones.miniTurno.esReaccion}}Terminar reacción{{else}}Terminar acción{{/if}}</button>
            {{else}}
              <button type="button" data-action="accionFueraCombate" data-reaccion="false" data-tooltip="Roba {{estadoAcciones.cartasMiniTurno}} cartas (el doble de tu Mano Máx.) y elige con cuál actuar"><i class="fa-solid fa-stopwatch"></i> Acción fuera de combate</button>
              <button type="button" data-action="accionFueraCombate" data-reaccion="true" data-tooltip="Roba {{estadoAcciones.cartasMiniTurno}} cartas una sola vez, cuando quien inició la acción ya ha elegido su carta. Si no tienes la carta adecuada, la reacción falla"><i class="fa-solid fa-bolt"></i> Reacción fuera de combate</button>
            {{/if}}
          </div>
        {{/if}}

        <div class="cyd-resumen-pilas">
          <span class="cyd-chip-pila" data-action="abrirPila" data-pila="mazo" data-tooltip="Abrir Mazo de Juego">
            <i class="fa-solid fa-layer-group"></i> Mazo <strong>{{contadoresPilas.mazoDisponibles}}/{{contadoresPilas.mazoTotal}}</strong>
          </span>
          <span class="cyd-chip-pila" data-action="abrirPila" data-pila="descarte" data-tooltip="Abrir Descarte">
            <i class="fa-solid fa-box-archive"></i> Descarte <strong>{{contadoresPilas.descarteActual}}</strong>
          </span>
          <span class="cyd-chip-pila" data-action="abrirPila" data-pila="quemadas" data-tooltip="Abrir Cartas Quemadas">
            <i class="fa-solid fa-fire"></i> Quemadas <strong>{{contadoresPilas.quemadasActual}}</strong>
          </span>
          <span class="cyd-chip-pila" data-action="abrirPila" data-pila="trinkets" data-tooltip="Abrir Mazo de Trinkets">
            <i class="fa-solid fa-gem"></i> Trinkets <strong>{{contadoresPilas.trinketsDisponibles}}/{{contadoresPilas.trinketsTotal}}</strong>
          </span>
          {{#if esPropietario}}
            <span class="cyd-separador"></span>
            <button type="button" class="cyd-btn-mini" data-action="crearCartaEnMazo" data-tipo-carta="accion" data-tooltip="Crear una nueva Carta de Acción en tu Mazo"><i class="fa-solid fa-plus"></i> Carta</button>
            <button type="button" class="cyd-btn-mini" data-action="crearCartaEnMazo" data-tipo-carta="trinket" data-tooltip="Crear un nuevo Trinket en tu Mazo de Trinkets"><i class="fa-solid fa-plus"></i> Trinket</button>
          {{/if}}
        </div>
      </section>

      {{!-- ================= 5. TRINKETS | HABILIDADES (rejilla adaptable de 2 columnas) ================= --}}
      <div class="cyd-dos-columnas cyd-fila-trinkets-habilidades">
        {{!-- Visor público de Trinkets --}}
        <section class="cyd-panel-trinkets">
          <div class="cyd-cabecera-seccion">
            <h3><i class="fa-solid fa-gem"></i> Trinkets</h3>
            <small>Pasa el cursor para ver sus efectos</small>
          </div>

          <div class="cyd-trinkets-activos-contenedor">
            <div class="cyd-subtitulo-panel">En Juego</div>
            {{#if trinketsEnJuego.length}}
              <div class="cyd-lista-pildoras">
                {{#each trinketsEnJuego as |trinket|}}
                  <div class="cyd-pildora-trinket cyd-estado-enJuego" data-tooltip="{{trinket.tooltipHtml}}" data-tooltip-class="cyd-tooltip">
                    <i class="fa-solid fa-circle cyd-estado-icono"></i>
                    <span class="cyd-pildora-nombre">{{trinket.nombre}}</span>
                    <span class="cyd-nivel">Nv. {{trinket.nivel}}</span>
                    {{#if ../esPropietario}}
                      <button type="button" class="cyd-btn-mini cyd-btn-icono" data-action="retirarTrinket" data-trinket-id="{{trinket.idEnPilaActual}}" data-quemar="false" data-tooltip="Enviar al Descarte"><i class="fa-solid fa-box-archive"></i></button>
                      <button type="button" class="cyd-btn-mini cyd-btn-icono cyd-peligro" data-action="retirarTrinket" data-trinket-id="{{trinket.idEnPilaActual}}" data-quemar="true" data-tooltip="Quemar Trinket"><i class="fa-solid fa-fire"></i></button>
                    {{/if}}
                  </div>
                {{/each}}
              </div>
            {{else}}
              <span class="cyd-texto-vacio">Ninguno activo.</span>
            {{/if}}
          </div>

          <div class="cyd-trinkets-coleccion">
            <div class="cyd-subtitulo-panel">Colección</div>
            {{#if todosLosTrinkets.length}}
              <div class="cyd-lista-pildoras">
                {{#each todosLosTrinkets as |trinket|}}
                  <div class="cyd-pildora-trinket cyd-estado-{{trinket.estado}}" data-tooltip="{{trinket.tooltipHtml}}" data-tooltip-class="cyd-tooltip">
                    <i class="fa-solid {{#if (eq trinket.estado "quemado")}}fa-fire{{else if (eq trinket.estado "descartado")}}fa-box-archive{{else if (eq trinket.estado "enMano")}}fa-hand{{else if (eq trinket.estado "enJuego")}}fa-circle{{else}}fa-circle-notch{{/if}} cyd-estado-icono"></i>
                    <strong class="cyd-pildora-nombre">{{trinket.nombre}}</strong>
                    <span class="cyd-nivel">Nv. {{trinket.nivel}}</span>
                    {{#if (and ../esPropietario trinket.estaDisponible)}}
                      <button type="button" class="cyd-btn-mini" data-action="robarTrinket" data-trinket-id="{{trinket.idOriginal}}" data-tooltip="Llevar a la Mano (descartando una carta)"><i class="fa-solid fa-hand"></i></button>
                    {{/if}}
                  </div>
                {{/each}}
              </div>
            {{else}}
              <span class="cyd-texto-vacio">Pulsa "Trinket" en Mazo y Pilas para añadir tu primer Trinket.</span>
            {{/if}}
          </div>
        </section>

        {{!-- Habilidades (activables con carta MIST) --}}
          <section class="cyd-panel cyd-panel-habilidades">
            <div class="cyd-cabecera-seccion">
              <h3><i class="fa-solid fa-wand-magic-sparkles"></i> Habilidades</h3>
              {{#if esPropietario}}
                <button type="button" class="cyd-btn-mini" data-action="crearItem" data-tipo="habilidad"><i class="fa-solid fa-plus"></i> Habilidad</button>
              {{/if}}
            </div>

            {{#if habilidades.length}}
              <div class="cyd-lista-items">
                {{#each habilidades as |hab|}}
                  <div class="cyd-fila-item" data-tooltip="{{hab.system.descripcion}}" data-tooltip-class="cyd-tooltip">
                    <div class="cyd-fila-item-info">
                      <strong class="cyd-link-item" data-action="editarItem" data-item-id="{{hab.id}}">{{hab.name}}</strong>
                      {{#if hab.system.origenHabilidad}}<small>{{hab.system.origenHabilidad}}</small>{{/if}}
                    </div>
                    <div class="cyd-fila-item-acciones">
                      {{#if ../esPropietario}}
                        <button type="button" class="cyd-btn-mini" data-action="usarHabilidad" data-item-id="{{hab.id}}" data-tooltip="{{#if hab.system.esActivable}}Activar (consume una carta MIST){{else}}Mostrar en el chat{{/if}}">
                          {{#if hab.system.esActivable}}<i class="fa-solid fa-dice-d20"></i> Usar{{else}}<i class="fa-solid fa-comment"></i> Chat{{/if}}
                        </button>
                        <button type="button" class="cyd-btn-mini cyd-btn-icono cyd-peligro" data-action="eliminarItem" data-item-id="{{hab.id}}" data-tooltip="Eliminar"><i class="fa-solid fa-xmark"></i></button>
                      {{/if}}
                    </div>
                  </div>
                {{/each}}
              </div>
            {{else}}
              <p class="cyd-texto-vacio">No tienes habilidades registradas.</p>
            {{/if}}
          </section>
      </div>

      {{!-- ================= 6. MANO ACTUAL DEL JUGADOR ================= --}}
      <section class="cyd-panel-mano">
        <div class="cyd-cabecera-seccion">
          <h3><i class="fa-solid fa-hand"></i> Mano <span class="cyd-contador">{{contadoresPilas.manoActual}} / {{system.limiteMano}}{{#if system.agotamiento.efectos.manoMitad}} <i class="fa-solid fa-hourglass-half cyd-icono-agotamiento" data-tooltip="Reducido a la mitad por Agotamiento"></i>{{/if}}</span></h3>
          <small class="cyd-ayuda"><i class="fa-solid fa-crosshairs"></i> «Usar» abre el diálogo de acción · para atacar, marca un objetivo con <kbd>T</kbd> antes</small>
        </div>

        {{#if esPropietario}}
          {{#if cartasEnMano.length}}
            <div class="cyd-grid-cartas">
              {{#each cartasEnMano as |carta|}}
                <article class="cyd-carta-item {{#if carta.esTrinket}}cyd-carta-trinket{{else}}cyd-palo-{{carta.palo}}{{/if}}">
                  <header class="cyd-carta-cabecera">
                    <span class="cyd-carta-titulo" data-tooltip="{{carta.nombre}}">{{carta.nombre}}</span>
                    {{#if carta.esTrinket}}
                      <span class="cyd-carta-dado cyd-tag-nivel">Nv. {{carta.nivel}}</span>
                    {{else}}
                      <span class="cyd-carta-dado">{{carta.cantidadDados}}{{carta.tipoDado}}</span>
                    {{/if}}
                  </header>
                  <div class="cyd-carta-subtitulo">
                    {{#if carta.esTrinket}}
                      <span><i class="fa-solid fa-gem"></i> Trinket</span>
                    {{else}}
                      <span><strong>{{carta.paloAbrev}}</strong> · {{carta.caracteristica}}</span>
                      {{#if carta.seQuema}}<span class="cyd-se-quema"><i class="fa-solid fa-fire"></i> Se quema</span>{{/if}}
                    {{/if}}
                  </div>
                  <div class="cyd-carta-efecto">{{{carta.efecto}}}</div>
                  <footer class="cyd-carta-acciones">
                    <button type="button" class="cyd-btn-jugar" data-action="jugarCarta" data-carta-id="{{carta.id}}" data-modo="usar" data-tooltip="Elegir la acción (apuntar, potenciar, reacción...) y tirar">
                      <i class="fa-solid fa-dice-d20"></i> Usar
                    </button>
                    <button type="button" class="cyd-btn-descartar" data-action="descartarCarta" data-carta-id="{{carta.id}}" data-tooltip="Descartar sin tirar (se anuncia en el chat)">
                      <i class="fa-solid fa-box-archive"></i> Descartar
                    </button>
                    <button type="button" class="cyd-btn-quemar" data-action="quemarCarta" data-carta-id="{{carta.id}}" data-tooltip="Quemar sin tirar (se anuncia en el chat)">
                      <i class="fa-solid fa-fire"></i> Quemar
                    </button>
                    <button type="button" class="cyd-btn-jugar-quemar" data-action="jugarCarta" data-carta-id="{{carta.id}}" data-modo="usar-y-quemar" data-tooltip="Usar la carta y quemarla después">
                      <i class="fa-solid fa-fire-flame-curved"></i> Usar y Quemar
                    </button>
                  </footer>
                </article>
              {{/each}}
            </div>
          {{else}}
            <p class="cyd-texto-vacio">Mano vacía. Crea cartas con "Carta" y pulsa "Inicio de Turno" para robar.</p>
          {{/if}}
        {{/if}}
      </section>

    {{/unless}}
    </section>

  </div>
  </section>

  {{!-- ================= PESTAÑA EQUIPO (v0.17.1): inventario de Objetos =================
       Independiente de las pilas de cartas: se muestra aunque aún no estén inicializadas. --}}
  <section class="tab cyd-pestana-equipo {{tabs.equipo.cssClass}}" data-group="primary" data-tab="equipo">
    <section class="cyd-panel cyd-panel-equipo">
      <div class="cyd-cabecera-seccion">
        <h3><i class="fa-solid fa-box-open"></i> Equipo</h3>
        {{#if esPropietario}}
          <button type="button" class="cyd-btn-mini" data-action="crearItem" data-tipo="objeto"><i class="fa-solid fa-plus"></i> Objeto</button>
        {{/if}}
      </div>

      {{#if objetos.length}}
        <div class="cyd-lista-items">
          {{#each objetos as |obj|}}
            <div class="cyd-fila-item {{#if obj.system.equipado}}cyd-item-equipado{{/if}}" data-tooltip="{{obj.system.descripcion}}" data-tooltip-class="cyd-tooltip">
              <div class="cyd-fila-item-info">
                <button type="button" class="cyd-btn-mini cyd-btn-icono cyd-btn-equipar {{#if obj.system.equipado}}cyd-activo{{/if}}" data-action="alternarEquipado" data-item-id="{{obj.id}}" data-tooltip="{{#if obj.system.equipado}}Desequipar{{else}}Equipar{{/if}}">
                  <i class="{{#if obj.system.equipado}}fa-solid fa-shield-halved{{else}}fa-regular fa-circle{{/if}}"></i>
                </button>
                <strong class="cyd-link-item" data-action="editarItem" data-item-id="{{obj.id}}">{{obj.name}}</strong>
                <small class="cyd-detalle-item">
                  {{#if obj.system.bonificadores.defensa}}<span><i class="fa-solid fa-shield-halved"></i> +{{obj.system.bonificadores.defensa}}</span>{{/if}}
                  {{#if obj.system.bonificadores.limiteMano}}<span><i class="fa-solid fa-hand"></i> +{{obj.system.bonificadores.limiteMano}}</span>{{/if}}
                </small>
              </div>
              <div class="cyd-fila-item-acciones">
                <span class="cyd-tag-cantidad">×{{obj.system.cantidad}}</span>
                {{#if ../esPropietario}}
                  <button type="button" class="cyd-btn-mini cyd-btn-icono cyd-peligro" data-action="eliminarItem" data-item-id="{{obj.id}}" data-tooltip="Eliminar"><i class="fa-solid fa-xmark"></i></button>
                {{/if}}
              </div>
            </div>
          {{/each}}
        </div>
      {{else}}
        <p class="cyd-texto-vacio">No tienes objetos en el inventario.</p>
      {{/if}}
    </section>
  </section>

  {{!-- ================= PESTAÑA RAZA (v0.13.1): descripción completa de los rasgos raciales =================
       Sin controles editables: los rasgos activables están en la pestaña Principal
       (evita inputs duplicados con el mismo `name` en el formulario). --}}
  <section class="tab cyd-pestana-raza {{tabs.raza.cssClass}}" data-group="primary" data-tab="raza">
    {{#if rasgosRaza}}
      <section class="cyd-panel cyd-panel-rasgos-raza">
        <div class="cyd-cabecera-seccion">
          <h3><i class="fa-solid fa-dna"></i> Rasgos Raciales · {{rasgosRaza.nombre}}</h3>
        </div>
        <div class="cyd-dos-columnas cyd-rasgos-columnas">
          <div class="cyd-rasgos-grupo">
            <h4><i class="fa-solid fa-circle-plus"></i> Beneficios</h4>
            <ul class="cyd-lista-rasgos cyd-lista-rasgos-completa">
              {{#each rasgosRaza.beneficios as |rasgo|}}
                <li class="cyd-rasgo">
                  <div class="cyd-rasgo-cabecera">
                    <strong><i class="fa-solid {{rasgo.icono}}"></i> {{rasgo.nombre}}</strong>
                    {{#if rasgo.aMano}}<span class="cyd-rasgo-tipo" data-tooltip="Su control está en la pestaña Principal"><i class="fa-solid fa-thumbtack"></i> En Principal</span>{{/if}}
                  </div>
                  <p class="cyd-rasgo-texto">{{rasgo.texto}}</p>
                  {{#if rasgo.auto}}<p class="cyd-rasgo-auto"><i class="fa-solid fa-gears"></i> {{rasgo.auto}}</p>{{/if}}
                </li>
              {{/each}}
            </ul>
          </div>
          <div class="cyd-rasgos-grupo">
            <h4><i class="fa-solid fa-circle-minus"></i> Desventajas</h4>
            <ul class="cyd-lista-rasgos cyd-lista-rasgos-completa">
              {{#each rasgosRaza.desventajas as |rasgo|}}
                <li class="cyd-rasgo">
                  <div class="cyd-rasgo-cabecera">
                    <strong><i class="fa-solid {{rasgo.icono}}"></i> {{rasgo.nombre}}</strong>
                    {{#if rasgo.aMano}}<span class="cyd-rasgo-tipo" data-tooltip="Su control está en la pestaña Principal"><i class="fa-solid fa-thumbtack"></i> En Principal</span>{{/if}}
                  </div>
                  <p class="cyd-rasgo-texto">{{rasgo.texto}}</p>
                  {{#if rasgo.auto}}<p class="cyd-rasgo-auto"><i class="fa-solid fa-gears"></i> {{rasgo.auto}}</p>{{/if}}
                </li>
              {{else}}
                <li class="cyd-rasgo"><p class="cyd-rasgo-texto">{{rasgosRaza.sinDesventajas}}</p></li>
              {{/each}}
            </ul>
          </div>
        </div>
      </section>
    {{else}}
      <p class="cyd-texto-vacio">Este personaje no tiene una Raza base. Elígela en la ranura Raza de la cabecera o con el Asistente de Clase.</p>
    {{/if}}
    {{#if itemRaza.system.descripcion}}
      <section class="cyd-panel">
        <div class="cyd-cabecera-seccion">
          <h3><i class="fa-solid fa-feather-pointed"></i> Descripción · {{itemRaza.name}}</h3>
        </div>
        <p class="cyd-rasgo-texto cyd-texto-multilinea">{{itemRaza.system.descripcion}}</p>
      </section>
    {{/if}}
  </section>

  </main>
</div>
