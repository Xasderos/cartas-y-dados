{{!--
  Plantilla táctica para Criaturas y PNJs en Foundry VTT v14 (ApplicationV2).
  - Selector de dado individual por cada característica y tirada directa.
  - Mazo de Jefe integrado (Mano, Mazo, Descarte y Quemadas visibles y usables, sin Trinkets).
  Iconografía (v0.9.0): solo iconos Font Awesome y símbolos tipográficos, sin emojis.
--}}
<div class="cyd-hoja-contenedor">

  {{!-- 1. CABECERA DE LA CRIATURA --}}
  <header class="cyd-cabecera">
    <div class="cyd-retrato">
      <img class="cyd-avatar" src="{{actor.img}}" alt="{{actor.name}}" data-action="verImagen" data-tooltip="Ver imagen a tamaño completo" />
      <div class="cyd-retrato-botones">
        {{#if retrato.puedeEditar}}
          <button type="button" class="cyd-btn-retrato" data-action="editarImagen" data-tooltip="Editar imagen" aria-label="Editar imagen"><i class="fa-solid fa-pen-to-square"></i></button>
        {{/if}}
        {{#if retrato.tieneToken}}
          <button type="button" class="cyd-btn-retrato" data-action="configurarToken" data-tooltip="Configurar Token" aria-label="Configurar Token"><i class="fa-solid fa-circle-user"></i></button>
        {{/if}}
      </div>
    </div>
    <div class="cyd-cabecera-principal">
      <div class="cyd-fila-titulo">
        <input type="text" name="name" value="{{actor.name}}" class="cyd-nombre-actor" placeholder="Nombre de la Criatura / PNJ" />
        <label class="cyd-badge-nivel" data-tooltip="Nivel de Amenaza del PNJ">
          <i class="fa-solid fa-skull"></i> Amenaza <input type="number" name="system.amenaza" value="{{system.amenaza}}" min="1" />
        </label>
      </div>
      <p class="cyd-subtitulo-cabecera">
        Criatura / PNJ ·
        {{#if tieneMazoJefe}}<strong>Mazo de Jefe activo</strong>{{else}}Sin Mazo de Jefe{{/if}}
        {{#unless tieneMazoJefe}}
          <button type="button" class="cyd-btn-mini" data-action="inicializarPilasJefe" data-tooltip="Crea e integra un Mazo de Jefe en esta ficha">
            <i class="fa-solid fa-layer-group"></i> Activar Mazo de Jefe
          </button>
        {{/unless}}
      </p>
    </div>
  </header>

  <main class="cyd-cuerpo-hoja">

  {{!-- 2. LAYOUT DOS COLUMNAS: ATRIBUTOS IZQUIERDA | CONTENIDO DERECHA ================= --}}
  <div class="cyd-layout-dos-columnas">

    {{!-- COLUMNA IZQUIERDA: RECURSOS, CARACTERÍSTICAS Y MOVIMIENTO ================= --}}
    <aside class="cyd-sidebar-atributos">
      {{!-- Recursos vitales (v0.13.1: encima de las Características) ================= --}}
      <div class="cyd-recursos-barra cyd-recursos-vitales cyd-cols-3">
        <div class="cyd-recurso-caja{{#if system.agotamiento.efectos.saludMitad}} cyd-afectado-agotamiento{{/if}}" data-tooltip="Base: {{system.salud.max}} + Físico: {{system.salud.bonoFisico}} + Bonos: {{system.salud.bonoOtros}}{{#if system.agotamiento.efectos.saludMitad}} = {{system.salud.maxSinAgotamiento}} | Agotamiento: ÷ 2{{/if}} = {{system.salud.maxTotal}}">
          <span class="cyd-recurso-titulo"><i class="fa-solid fa-heart-pulse"></i> Salud</span>
          <div class="cyd-recurso-inputs">
            <input type="number" name="system.salud.value" value="{{system.salud.value}}" />
            <span class="cyd-valor-sep">/</span>
            <span class="cyd-valor-grande">{{system.salud.maxTotal}}</span>{{#if system.agotamiento.efectos.saludMitad}} <i class="fa-solid fa-hourglass-half cyd-icono-agotamiento" data-tooltip="Reducido a la mitad por Agotamiento"></i>{{/if}}
          </div>
          <meter class="cyd-barra-salud {{barraSalud.estado}}" min="0" max="{{barraSalud.maximo}}" value="{{barraSalud.valor}}" aria-label="Salud" data-tooltip="Salud: {{barraSalud.valor}} / {{barraSalud.maximo}} ({{barraSalud.porcentaje}} %)"></meter>
        </div>

        <div class="cyd-recurso-caja" data-tooltip="Salud Base de la criatura (antes de Físico y bonos)">
          <span class="cyd-recurso-titulo"><i class="fa-solid fa-heart"></i> Salud Base</span>
          <div class="cyd-recurso-inputs">
            <input type="number" name="system.salud.max" value="{{system.salud.max}}" />
          </div>
        </div>

        <div class="cyd-recurso-caja" data-tooltip="Defensa Base: {{system.defensa}} | Bono Equipo: +{{system.bonificadorDefensa}} | Total: {{system.defensaTotal}}">
          <span class="cyd-recurso-titulo"><i class="fa-solid fa-shield-halved"></i> Defensa</span>
          <div class="cyd-recurso-inputs">
            <input type="number" name="system.defensa" value="{{system.defensa}}" min="0" />
            <span class="cyd-valor-sep">→</span>
            <span class="cyd-valor-grande">{{system.defensaTotal}}</span>
          </div>
        </div>

      </div>


      <div class="cyd-cabecera-seccion">
        <h3><i class="fa-solid fa-star-of-life"></i> Características</h3>
      </div>

      {{!-- FÍSICO --}}
      <div class="cyd-atributo-tarjeta" data-tooltip="Base: {{system.caracteristicas.fisico}}">
        <div class="cyd-atributo-cabecera">
          <span class="cyd-atributo-sello"><i class="fa-solid fa-hand-fist"></i></span>
          <span class="cyd-atributo-nombre">Físico</span>
          <span class="cyd-atributo-abrev">FISC</span>
        </div>
        <div class="cyd-atributo-fila-valores">
          <input type="number" name="system.caracteristicas.fisico" value="{{system.caracteristicas.fisico}}" min="1" max="10" title="Valor Base" />
          <select name="system.dadosCaracteristicas.fisico" class="cyd-select-dado-individual" title="Tamaño de dado de Físico">
            <option value="d4" {{#if (eq system.dadosCaracteristicas.fisico "d4")}}selected{{/if}}>d4</option>
            <option value="d6" {{#if (eq system.dadosCaracteristicas.fisico "d6")}}selected{{/if}}>d6</option>
            <option value="d8" {{#if (eq system.dadosCaracteristicas.fisico "d8")}}selected{{/if}}>d8</option>
            <option value="d10" {{#if (eq system.dadosCaracteristicas.fisico "d10")}}selected{{/if}}>d10</option>
            <option value="d12" {{#if (eq system.dadosCaracteristicas.fisico "d12")}}selected{{/if}}>d12</option>
          </select>
          <button type="button" class="cyd-btn-atributo-pnj" data-action="tiradaAtributoPnj" data-caracteristica="fisico" data-dado="{{system.dadosCaracteristicas.fisico}}" data-tooltip="Tirar Físico directamente">
            <i class="fa-solid fa-dice-d20"></i> Tirar
          </button>
        </div>
      </div>

      {{!-- CONSCIENCIA --}}
      <div class="cyd-atributo-tarjeta" data-tooltip="Base: {{system.caracteristicas.consciencia}}">
        <div class="cyd-atributo-cabecera">
          <span class="cyd-atributo-sello"><i class="fa-solid fa-eye"></i></span>
          <span class="cyd-atributo-nombre">Consciencia</span>
          <span class="cyd-atributo-abrev">CONS</span>
        </div>
        <div class="cyd-atributo-fila-valores">
          <input type="number" name="system.caracteristicas.consciencia" value="{{system.caracteristicas.consciencia}}" min="1" max="10" title="Valor Base" />
          <select name="system.dadosCaracteristicas.consciencia" class="cyd-select-dado-individual" title="Tamaño de dado de Consciencia">
            <option value="d4" {{#if (eq system.dadosCaracteristicas.consciencia "d4")}}selected{{/if}}>d4</option>
            <option value="d6" {{#if (eq system.dadosCaracteristicas.consciencia "d6")}}selected{{/if}}>d6</option>
            <option value="d8" {{#if (eq system.dadosCaracteristicas.consciencia "d8")}}selected{{/if}}>d8</option>
            <option value="d10" {{#if (eq system.dadosCaracteristicas.consciencia "d10")}}selected{{/if}}>d10</option>
            <option value="d12" {{#if (eq system.dadosCaracteristicas.consciencia "d12")}}selected{{/if}}>d12</option>
          </select>
          <button type="button" class="cyd-btn-atributo-pnj" data-action="tiradaAtributoPnj" data-caracteristica="consciencia" data-dado="{{system.dadosCaracteristicas.consciencia}}" data-tooltip="Tirar Consciencia directamente">
            <i class="fa-solid fa-dice-d20"></i> Tirar
          </button>
        </div>
      </div>

      {{!-- SOCIAL --}}
      <div class="cyd-atributo-tarjeta" data-tooltip="Base: {{system.caracteristicas.social}}">
        <div class="cyd-atributo-cabecera">
          <span class="cyd-atributo-sello"><i class="fa-solid fa-masks-theater"></i></span>
          <span class="cyd-atributo-nombre">Social</span>
          <span class="cyd-atributo-abrev">SOC</span>
        </div>
        <div class="cyd-atributo-fila-valores">
          <input type="number" name="system.caracteristicas.social" value="{{system.caracteristicas.social}}" min="1" max="10" title="Valor Base" />
          <select name="system.dadosCaracteristicas.social" class="cyd-select-dado-individual" title="Tamaño de dado de Social">
            <option value="d4" {{#if (eq system.dadosCaracteristicas.social "d4")}}selected{{/if}}>d4</option>
            <option value="d6" {{#if (eq system.dadosCaracteristicas.social "d6")}}selected{{/if}}>d6</option>
            <option value="d8" {{#if (eq system.dadosCaracteristicas.social "d8")}}selected{{/if}}>d8</option>
            <option value="d10" {{#if (eq system.dadosCaracteristicas.social "d10")}}selected{{/if}}>d10</option>
            <option value="d12" {{#if (eq system.dadosCaracteristicas.social "d12")}}selected{{/if}}>d12</option>
          </select>
          <button type="button" class="cyd-btn-atributo-pnj" data-action="tiradaAtributoPnj" data-caracteristica="social" data-dado="{{system.dadosCaracteristicas.social}}" data-tooltip="Tirar Social directamente">
            <i class="fa-solid fa-dice-d20"></i> Tirar
          </button>
        </div>
      </div>

      {{!-- MISTICISMO --}}
      <div class="cyd-atributo-tarjeta" data-tooltip="Base: {{system.caracteristicas.misticismo}}">
        <div class="cyd-atributo-cabecera">
          <span class="cyd-atributo-sello"><i class="fa-solid fa-moon"></i></span>
          <span class="cyd-atributo-nombre">Misticismo</span>
          <span class="cyd-atributo-abrev">MIST</span>
        </div>
        <div class="cyd-atributo-fila-valores">
          <input type="number" name="system.caracteristicas.misticismo" value="{{system.caracteristicas.misticismo}}" min="1" max="10" title="Valor Base" />
          <select name="system.dadosCaracteristicas.misticismo" class="cyd-select-dado-individual" title="Tamaño de dado de Misticismo">
            <option value="d4" {{#if (eq system.dadosCaracteristicas.misticismo "d4")}}selected{{/if}}>d4</option>
            <option value="d6" {{#if (eq system.dadosCaracteristicas.misticismo "d6")}}selected{{/if}}>d6</option>
            <option value="d8" {{#if (eq system.dadosCaracteristicas.misticismo "d8")}}selected{{/if}}>d8</option>
            <option value="d10" {{#if (eq system.dadosCaracteristicas.misticismo "d10")}}selected{{/if}}>d10</option>
            <option value="d12" {{#if (eq system.dadosCaracteristicas.misticismo "d12")}}selected{{/if}}>d12</option>
          </select>
          <button type="button" class="cyd-btn-atributo-pnj" data-action="tiradaAtributoPnj" data-caracteristica="misticismo" data-dado="{{system.dadosCaracteristicas.misticismo}}" data-tooltip="Tirar Misticismo directamente">
            <i class="fa-solid fa-dice-d20"></i> Tirar
          </button>
        </div>
      </div>

      <p class="cyd-nota-sidebar">
        <i class="fa-solid fa-circle-info"></i>
        <span>Valor base · dado · tirada directa sin cartas.</span>
      </p>

      {{!-- ================= MOVIMIENTO Y TAMAÑO (v0.13.1: bajo las Características) ================= --}}
      <section class="cyd-panel cyd-panel-movimiento-tamano">
        <div class="cyd-cabecera-seccion">
          <h3><i class="fa-solid fa-shoe-prints"></i> Movimiento y Tamaño</h3>
        </div>
        <div class="cyd-recursos-barra cyd-cols-2">
          <div class="cyd-recurso-caja{{#if system.agotamiento.efectos.velocidadMitad}} cyd-afectado-agotamiento{{/if}}" data-tooltip="Base de Movimiento editable en esta ficha. El Total se calcula automáticamente: Base + (Físico Total × 5) metros{{#if system.agotamiento.efectos.velocidadMitad}} | Agotamiento: {{system.movimiento.maxSinAgotamiento}} ÷ 2{{/if}}">
            <span class="cyd-recurso-titulo"><i class="fa-solid fa-person-running"></i> Movimiento · Base / Total</span>
            <div class="cyd-recurso-inputs">
              <input type="number" name="system.movimiento.base" value="{{system.movimiento.base}}" min="0" />
              <span class="cyd-valor-sep">/</span>
              <span class="cyd-valor-grande">{{system.movimiento.max}}</span>{{#if system.agotamiento.efectos.velocidadMitad}} <i class="fa-solid fa-hourglass-half cyd-icono-agotamiento" data-tooltip="Reducido a la mitad por Agotamiento"></i>{{/if}}
              <span class="cyd-unidad">m</span>
            </div>
          </div>
          <div class="cyd-recurso-caja" data-tooltip="Categoría de tamaño de la criatura">
            <span class="cyd-recurso-titulo"><i class="fa-solid fa-ruler-vertical"></i> Tamaño</span>
            <select name="system.categoriaTamano">
              <option value="Diminuto" {{#if (eq system.categoriaTamano "Diminuto")}}selected{{/if}}>Diminuto</option>
              <option value="Pequeño" {{#if (eq system.categoriaTamano "Pequeño")}}selected{{/if}}>Pequeño</option>
              <option value="Mediano" {{#if (eq system.categoriaTamano "Mediano")}}selected{{/if}}>Mediano</option>
              <option value="Grande" {{#if (eq system.categoriaTamano "Grande")}}selected{{/if}}>Grande</option>
              <option value="Enorme" {{#if (eq system.categoriaTamano "Enorme")}}selected{{/if}}>Enorme</option>
            </select>
          </div>
        </div>
      </section>
    </aside>

    {{!-- COLUMNA DERECHA: AGOTAMIENTO, MAZO DE JEFE ================= --}}
    <section class="cyd-contenido-derecha">

      {{!-- Agotamiento (v0.12.0): barra de 8 segmentos (clic para fijar el nivel) y consecuencias en vigor ================= --}}
      <section class="cyd-panel cyd-panel-agotamiento{{#if agotamiento.muerto}} cyd-muerto{{/if}}">
        <div class="cyd-cabecera-seccion">
          <h3 data-tooltip="{{agotamiento.tooltipHtml}}" data-tooltip-class="cyd-tooltip"><i class="fa-solid fa-hourglass-half"></i> Agotamiento</h3>
        </div>
        <div class="cyd-barra-agotamiento{{#if esPropietario}} cyd-editable{{/if}}" role="meter" aria-label="Agotamiento" aria-valuemin="0" aria-valuemax="{{agotamiento.maximo}}" aria-valuenow="{{agotamiento.nivel}}">
          {{#each agotamiento.segmentos as |seg|}}
            <span class="cyd-segmento-agotamiento{{#if seg.activo}} cyd-lleno{{/if}}{{#if seg.esMuerte}} cyd-segmento-muerte{{/if}}"
                  {{#if @root.esPropietario}}data-action="fijarAgotamiento" data-nivel="{{seg.nivel}}" tabindex="0"{{/if}}
                  data-tooltip="Nivel {{seg.nivel}}: {{seg.texto}}"></span>
          {{/each}}
        </div>
        {{#if agotamiento.nivel}}
          <ul class="cyd-lista-agotamiento">
            {{#each agotamiento.activos as |efecto|}}
              <li><i class="fa-solid {{efecto.icono}}"></i> <strong>{{efecto.nivel}}.</strong> {{efecto.texto}}</li>
            {{/each}}
          </ul>
        {{else}}
          <p class="cyd-agotamiento-vacio">Sin Agotamiento.</p>
        {{/if}}
      </section>


    {{!-- 4. ZONA DE MAZO DE JEFE (SOLO SI ESTÁ ACTIVO; SIN TRINKETS) --}}
    {{#if tieneMazoJefe}}
      <section class="cyd-panel-controles">
        <div class="cyd-cabecera-seccion">
          <h3><i class="fa-solid fa-layer-group"></i> Mazo de Jefe</h3>
        </div>

        <div class="cyd-acciones-turno cyd-cols-3">
          <button type="button" data-action="robarTurno"><i class="fa-solid fa-clone"></i> Robar Turno</button>
          <button type="button" data-action="finCombate"><i class="fa-solid fa-rotate"></i> Fin de Combate</button>
          <button type="button" data-action="descansar"><i class="fa-solid fa-campground"></i> Descansar</button>
        </div>
        {{!-- (v0.14.0) Estado de acción: combate, reacción y acción fuera de combate (mini turno) --}}
        <div class="cyd-estado-acciones">
          <span class="cyd-chip-estado{{#if estadoAcciones.enCombate}} cyd-activo{{/if}}" data-tooltip="{{#if estadoAcciones.enCombate}}En combate: usa las cartas de tu mano; robas al inicio de tu turno{{else}}Fuera de combate: roba el doble de tu Mano Máx. para cada acción{{/if}}">
            <i class="fa-solid {{#if estadoAcciones.enCombate}}fa-khanda{{else}}fa-person-walking{{/if}}"></i> {{#if estadoAcciones.enCombate}}En combate{{else}}Fuera de combate{{/if}}
          </span>
          {{#if estadoAcciones.sinReacciones}}
            <span class="cyd-chip-estado cyd-bloqueado" data-tooltip="Agotamiento 4+: no puede realizar reacciones (solo como excepción)"><i class="fa-solid fa-ban"></i> Sin reacciones</span>
          {{else if estadoAcciones.reaccionUsada}}
            <span class="cyd-chip-estado cyd-bloqueado" data-action="restablecerReaccion" data-tooltip="Reacción usada: se recupera al inicio de tu turno. Clic para recuperarla ahora (excepción)"><i class="fa-solid fa-bolt"></i> Reacción usada</span>
          {{else}}
            <span class="cyd-chip-estado" data-tooltip="Puedes realizar una reacción hasta que vuelva a ser tu turno"><i class="fa-solid fa-bolt"></i> Reacción disponible</span>
          {{/if}}
          {{#if estadoAcciones.miniTurno}}
            <span class="cyd-chip-estado cyd-activo" data-tooltip="Cada mano robada (tantas cartas como tu Mano Máx.) equivale a un turno de tiempo">
              <i class="fa-solid fa-stopwatch"></i> {{#if estadoAcciones.miniTurno.esReaccion}}Reacción{{else}}Acción{{/if}} fuera de combate · {{estadoAcciones.miniTurno.manos}} manos
            </span>
          {{/if}}
        </div>
        <div class="cyd-acciones-turno cyd-cols-2">
          {{#if estadoAcciones.miniTurno}}
            {{#if estadoAcciones.miniTurno.esReaccion}}
              <span class="cyd-chip-estado cyd-bloqueado" data-tooltip="Una reacción fuera de combate solo roba una mano: si no tienes la carta adecuada, falla"><i class="fa-solid fa-ban"></i> Sin más robos</span>
              {{else}}
              <button type="button" data-action="otraManoMiniTurno" data-tooltip="Roba tantas cartas como tu Mano Máx.: la acción tarda un turno más"><i class="fa-solid fa-clone"></i> Robar otra mano</button>
              {{/if}}
            <button type="button" data-action="terminarMiniTurno" data-tooltip="{{#if estadoAcciones.miniTurno.esReaccion}}Termina la reacción; si no has usado ninguna carta, falla{{else}}Termina la acción y decide qué hacer con las cartas que quedan en la mano{{/if}}"><i class="fa-solid fa-hourglass-end"></i> {{#if estadoAcciones.miniTurno.esReaccion}}Terminar reacción{{else}}Terminar acción{{/if}}</button>
          {{else}}
            <button type="button" data-action="accionFueraCombate" data-reaccion="false" data-tooltip="Roba {{estadoAcciones.cartasMiniTurno}} cartas (el doble de tu Mano Máx.) y elige con cuál actuar"><i class="fa-solid fa-stopwatch"></i> Acción fuera de combate</button>
            <button type="button" data-action="accionFueraCombate" data-reaccion="true" data-tooltip="Roba {{estadoAcciones.cartasMiniTurno}} cartas una sola vez, cuando quien inició la acción ya ha elegido su carta. Si no tienes la carta adecuada, la reacción falla"><i class="fa-solid fa-bolt"></i> Reacción fuera de combate</button>
          {{/if}}
        </div>

        <div class="cyd-resumen-pilas">
          <span class="cyd-chip-pila" data-action="abrirPila" data-pila="mazo" data-tooltip="Abrir Mazo del Jefe">
            <i class="fa-solid fa-layer-group"></i> Mazo <strong>{{contadoresPilas.mazoDisponibles}}/{{contadoresPilas.mazoTotal}}</strong>
          </span>
          <span class="cyd-chip-pila" data-action="abrirPila" data-pila="mano" data-tooltip="Abrir Mano del Jefe">
            <i class="fa-solid fa-hand"></i> Mano <strong>{{contadoresPilas.manoActual}}/{{system.limiteMano}}</strong>{{#if system.agotamiento.efectos.manoMitad}} <i class="fa-solid fa-hourglass-half cyd-icono-agotamiento" data-tooltip="Reducido a la mitad por Agotamiento"></i>{{/if}}
          </span>
          <span class="cyd-chip-pila" data-action="abrirPila" data-pila="descarte" data-tooltip="Abrir Descarte del Jefe">
            <i class="fa-solid fa-box-archive"></i> Descarte <strong>{{contadoresPilas.descarteActual}}</strong>
          </span>
          <span class="cyd-chip-pila" data-action="abrirPila" data-pila="quemadas" data-tooltip="Abrir Quemadas del Jefe">
            <i class="fa-solid fa-fire"></i> Quemadas <strong>{{contadoresPilas.quemadasActual}}</strong>
          </span>
          <span class="cyd-separador"></span>
          <button type="button" class="cyd-btn-mini" data-action="crearCartaEnMazo" data-tooltip="Crear una nueva Carta de Acción en el Mazo del Jefe"><i class="fa-solid fa-plus"></i> Carta</button>
        </div>
      </section>

      <section class="cyd-panel-mano">
        <div class="cyd-cabecera-seccion">
          <h3><i class="fa-solid fa-hand"></i> Mano del Jefe <span class="cyd-contador">{{contadoresPilas.manoActual}} / {{system.limiteMano}}{{#if system.agotamiento.efectos.manoMitad}} <i class="fa-solid fa-hourglass-half cyd-icono-agotamiento" data-tooltip="Reducido a la mitad por Agotamiento"></i>{{/if}}</span></h3>
          <small class="cyd-ayuda"><i class="fa-solid fa-crosshairs"></i> Marca un PJ con <kbd>T</kbd> antes de atacar</small>
        </div>

        {{#if cartasEnMano.length}}
          <div class="cyd-grid-cartas">
            {{#each cartasEnMano as |carta|}}
              <article class="cyd-carta-item cyd-palo-{{carta.palo}}">
                <header class="cyd-carta-cabecera">
                  <span class="cyd-carta-titulo" data-tooltip="{{carta.nombre}}">{{carta.nombre}}</span>
                  <span class="cyd-carta-dado">{{carta.cantidadDados}}{{carta.tipoDado}}</span>
                </header>
                <div class="cyd-carta-subtitulo">
                  <span><strong>{{carta.paloAbrev}}</strong> · {{carta.caracteristica}}</span>
                  {{#if carta.seQuema}}<span class="cyd-se-quema"><i class="fa-solid fa-fire"></i> Se quema</span>{{/if}}
                </div>
                <div class="cyd-carta-efecto">{{{carta.efecto}}}</div>
                <footer class="cyd-carta-acciones">
                  <button type="button" class="cyd-btn-jugar" data-action="jugarCarta" data-carta-id="{{carta.id}}" data-modo="usar" data-tooltip="Elegir la acción (apuntar, potenciar, reacción...) y tirar">
                    <i class="fa-solid fa-dice-d20"></i> Usar
                  </button>
                  <button type="button" class="cyd-btn-descartar" data-action="descartarCarta" data-carta-id="{{carta.id}}" data-tooltip="Descartar sin tirar (se anuncia en el chat)">
                    <i class="fa-solid fa-box-archive"></i> Descartar
                  </button>
                  <button type="button" class="cyd-btn-quemar" data-action="quemarCarta" data-carta-id="{{carta.id}}" data-tooltip="Quemar sin tirar (se anuncia en el chat)">
                    <i class="fa-solid fa-fire"></i> Quemar
                  </button>
                  <button type="button" class="cyd-btn-jugar-quemar" data-action="jugarCarta" data-carta-id="{{carta.id}}" data-modo="usar-y-quemar" data-tooltip="Usar la carta y quemarla después">
                    <i class="fa-solid fa-fire-flame-curved"></i> Usar y Quemar
                  </button>
                </footer>
              </article>
            {{/each}}
          </div>
        {{else}}
          <p class="cyd-texto-vacio">Mano vacía. Pulsa "Robar Turno" para robar cartas.</p>
        {{/if}}
      </section>
    {{/if}}

    {{!-- 5. HABILIDADES Y EQUIPO --}}
    <div class="cyd-dos-columnas">

      <section class="cyd-panel">
        <div class="cyd-cabecera-seccion">
          <h3><i class="fa-solid fa-wand-magic-sparkles"></i> Ataques y Habilidades</h3>
          <button type="button" class="cyd-btn-mini" data-action="crearItemPnj" data-tipo="habilidad"><i class="fa-solid fa-plus"></i> Habilidad</button>
        </div>

        {{#if habilidades.length}}
          <div class="cyd-lista-items">
            {{#each habilidades as |hab|}}
              <div class="cyd-fila-item" data-tooltip="{{hab.system.descripcion}}" data-tooltip-class="cyd-tooltip">
                <div class="cyd-fila-item-info">
                  <strong class="cyd-link-item" data-action="editarItem" data-item-id="{{hab.id}}">{{hab.name}}</strong>
                  <small>{{hab.system.caracteristica}} · {{hab.system.tipoDado}}{{#if hab.system.bonoTirada}}+{{hab.system.bonoTirada}}{{/if}}</small>
                </div>
                <div class="cyd-fila-item-acciones">
                  <button type="button" class="cyd-btn-mini" data-action="usarHabilidad" data-item-id="{{hab.id}}" data-tooltip="{{#if hab.system.esAtaque}}Atacar{{else}}Activar{{/if}}">
                    {{#if hab.system.esAtaque}}<i class="fa-solid fa-crosshairs"></i> Atacar{{else}}<i class="fa-solid fa-dice-d20"></i> Usar{{/if}}
                  </button>
                  <button type="button" class="cyd-btn-mini cyd-btn-icono cyd-peligro" data-action="eliminarItem" data-item-id="{{hab.id}}" data-tooltip="Eliminar"><i class="fa-solid fa-xmark"></i></button>
                </div>
              </div>
            {{/each}}
          </div>
        {{else}}
          <p class="cyd-texto-vacio">Sin habilidades registradas.</p>
        {{/if}}
      </section>

      <section class="cyd-panel">
        <div class="cyd-cabecera-seccion">
          <h3><i class="fa-solid fa-box-open"></i> Equipo</h3>
          <button type="button" class="cyd-btn-mini" data-action="crearItemPnj" data-tipo="objeto"><i class="fa-solid fa-plus"></i> Objeto</button>
        </div>

        {{#if objetos.length}}
          <div class="cyd-lista-items">
            {{#each objetos as |obj|}}
              <div class="cyd-fila-item {{#if obj.system.equipado}}cyd-item-equipado{{/if}}" data-tooltip="{{obj.system.descripcion}}" data-tooltip-class="cyd-tooltip">
                <div class="cyd-fila-item-info">
                  <button type="button" class="cyd-btn-mini cyd-btn-icono cyd-btn-equipar {{#if obj.system.equipado}}cyd-activo{{/if}}" data-action="alternarEquipado" data-item-id="{{obj.id}}" data-tooltip="{{#if obj.system.equipado}}Desequipar{{else}}Equipar{{/if}}">
                    <i class="{{#if obj.system.equipado}}fa-solid fa-shield-halved{{else}}fa-regular fa-circle{{/if}}"></i>
                  </button>
                  <strong class="cyd-link-item" data-action="editarItem" data-item-id="{{obj.id}}">{{obj.name}}</strong>
                  <small class="cyd-detalle-item">
                    {{#if obj.system.bonificadores.defensa}}<span><i class="fa-solid fa-shield-halved"></i> +{{obj.system.bonificadores.defensa}}</span>{{/if}}
                    {{#if obj.system.bonificadores.saludMax}}<span><i class="fa-solid fa-heart-pulse"></i> +{{obj.system.bonificadores.saludMax}}</span>{{/if}}
                  </small>
                </div>
                <div class="cyd-fila-item-acciones">
                  <span class="cyd-tag-cantidad">×{{obj.system.cantidad}}</span>
                  <button type="button" class="cyd-btn-mini cyd-btn-icono cyd-peligro" data-action="eliminarItem" data-item-id="{{obj.id}}" data-tooltip="Eliminar"><i class="fa-solid fa-xmark"></i></button>
                </div>
              </div>
            {{/each}}
          </div>
        {{else}}
          <p class="cyd-texto-vacio">Sin objetos ni armaduras.</p>
        {{/if}}
      </section>

    </div>

    {{!-- 6. NOTAS DEL MASTER --}}
    <section class="cyd-panel cyd-panel-flex">
      <div class="cyd-cabecera-seccion">
        <h3><i class="fa-solid fa-feather-pointed"></i> Comportamiento y Notas</h3>
      </div>
      <textarea name="system.biografia" rows="3" class="cyd-textarea">{{system.biografia}}</textarea>
    </section>

    </section>

  </div>

  </main>
</div>
