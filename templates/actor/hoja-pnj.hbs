{{!--
  Plantilla táctica para Criaturas y PNJs en Foundry VTT v14 (ApplicationV2).
  - Selector de dado individual por cada característica.
  - Mazo de Jefe integrado (Mano, Mazo, Descarte y Quemadas visibles y usables, sin Trinkets).
--}}
<div class="cyd-hoja-contenedor">

  {{!-- 1. CABECERA DE LA CRIATURA --}}
  <header class="cyd-cabecera">
    <img class="cyd-avatar" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" />
    <div class="cyd-cabecera-principal">
      <div class="cyd-fila-titulo">
        <input type="text" name="name" value="{{actor.name}}" class="cyd-nombre-actor" placeholder="Nombre de la Criatura / PNJ" />
        <label class="cyd-badge-nivel" data-tooltip="Nivel de Amenaza del PNJ">
          💀 Amenaza <input type="number" name="system.amenaza" value="{{system.amenaza}}" min="1" />
        </label>
        {{#unless tieneMazoJefe}}
          <button type="button" class="cyd-btn-mini" data-action="inicializarPilasJefe" data-tooltip="Crea e integra un Mazo de Jefe en esta ficha">
            🃏 Activar Mazo de Jefe
          </button>
        {{/unless}}
      </div>

    </div>
  </header>

  <main class="cyd-cuerpo-hoja">

  {{!-- 2. LAYOUT DOS COLUMNAS: ATRIBUTOS IZQUIERDA | CONTENIDO DERECHA ================= --}}
  <div class="cyd-layout-dos-columnas">

    {{!-- COLUMNA IZQUIERDA: ATRIBUTOS ================= --}}
    <aside class="cyd-sidebar-atributos">
      <div class="cyd-cabecera-seccion">
        <h3>📊 Características</h3>
      </div>

      {{!-- FÍSICO --}}
      <div class="cyd-atributo-tarjeta" data-tooltip="Base: {{system.caracteristicas.fisico}}">
        <span class="cyd-atributo-icono">⚔️ Físico (FISC)</span>
        <div class="cyd-atributo-fila-valores">
          <input type="number" name="system.caracteristicas.fisico" value="{{system.caracteristicas.fisico}}" min="1" max="10" title="Valor Base" />
          <select name="system.dadosCaracteristicas.fisico" class="cyd-select-dado-individual" title="Tamaño de dado de Físico">
            <option value="d4" {{#if (eq system.dadosCaracteristicas.fisico "d4")}}selected{{/if}}>d4</option>
            <option value="d6" {{#if (eq system.dadosCaracteristicas.fisico "d6")}}selected{{/if}}>d6</option>
            <option value="d8" {{#if (eq system.dadosCaracteristicas.fisico "d8")}}selected{{/if}}>d8</option>
            <option value="d10" {{#if (eq system.dadosCaracteristicas.fisico "d10")}}selected{{/if}}>d10</option>
            <option value="d12" {{#if (eq system.dadosCaracteristicas.fisico "d12")}}selected{{/if}}>d12</option>
          </select>
          <button type="button" class="cyd-btn-atributo-pnj" data-action="tiradaAtributoPnj" data-caracteristica="fisico" data-dado="{{system.dadosCaracteristicas.fisico}}" data-tooltip="Tirar atributo Físico directamente">
            🎲 Tirar
          </button>
        </div>
      </div>

      {{!-- CONSCIENCIA --}}
      <div class="cyd-atributo-tarjeta" data-tooltip="Base: {{system.caracteristicas.consciencia}}">
        <span class="cyd-atributo-icono">🦯 Consciencia (CONS)</span>
        <div class="cyd-atributo-fila-valores">
          <input type="number" name="system.caracteristicas.consciencia" value="{{system.caracteristicas.consciencia}}" min="1" max="10" title="Valor Base" />
          <select name="system.dadosCaracteristicas.consciencia" class="cyd-select-dado-individual" title="Tamaño de dado de Consciencia">
            <option value="d4" {{#if (eq system.dadosCaracteristicas.consciencia "d4")}}selected{{/if}}>d4</option>
            <option value="d6" {{#if (eq system.dadosCaracteristicas.consciencia "d6")}}selected{{/if}}>d6</option>
            <option value="d8" {{#if (eq system.dadosCaracteristicas.consciencia "d8")}}selected{{/if}}>d8</option>
            <option value="d10" {{#if (eq system.dadosCaracteristicas.consciencia "d10")}}selected{{/if}}>d10</option>
            <option value="d12" {{#if (eq system.dadosCaracteristicas.consciencia "d12")}}selected{{/if}}>d12</option>
          </select>
          <button type="button" class="cyd-btn-atributo-pnj" data-action="tiradaAtributoPnj" data-caracteristica="consciencia" data-dado="{{system.dadosCaracteristicas.consciencia}}" data-tooltip="Tirar atributo Consciencia directamente">
            🎲 Tirar
          </button>
        </div>
      </div>

      {{!-- SOCIAL --}}
      <div class="cyd-atributo-tarjeta" data-tooltip="Base: {{system.caracteristicas.social}}">
        <span class="cyd-atributo-icono">🪙 Social (SOC)</span>
        <div class="cyd-atributo-fila-valores">
          <input type="number" name="system.caracteristicas.social" value="{{system.caracteristicas.social}}" min="1" max="10" title="Valor Base" />
          <select name="system.dadosCaracteristicas.social" class="cyd-select-dado-individual" title="Tamaño de dado de Social">
            <option value="d4" {{#if (eq system.dadosCaracteristicas.social "d4")}}selected{{/if}}>d4</option>
            <option value="d6" {{#if (eq system.dadosCaracteristicas.social "d6")}}selected{{/if}}>d6</option>
            <option value="d8" {{#if (eq system.dadosCaracteristicas.social "d8")}}selected{{/if}}>d8</option>
            <option value="d10" {{#if (eq system.dadosCaracteristicas.social "d10")}}selected{{/if}}>d10</option>
            <option value="d12" {{#if (eq system.dadosCaracteristicas.social "d12")}}selected{{/if}}>d12</option>
          </select>
          <button type="button" class="cyd-btn-atributo-pnj" data-action="tiradaAtributoPnj" data-caracteristica="social" data-dado="{{system.dadosCaracteristicas.social}}" data-tooltip="Tirar atributo Social directamente">
            🎲 Tirar
          </button>
        </div>
      </div>

      {{!-- MISTICISMO --}}
      <div class="cyd-atributo-tarjeta" data-tooltip="Base: {{system.caracteristicas.misticismo}}">
        <span class="cyd-atributo-icono">🏆 Misticismo (MIST)</span>
        <div class="cyd-atributo-fila-valores">
          <input type="number" name="system.caracteristicas.misticismo" value="{{system.caracteristicas.misticismo}}" min="1" max="10" title="Valor Base" />
          <select name="system.dadosCaracteristicas.misticismo" class="cyd-select-dado-individual" title="Tamaño de dado de Misticismo">
            <option value="d4" {{#if (eq system.dadosCaracteristicas.misticismo "d4")}}selected{{/if}}>d4</option>
            <option value="d6" {{#if (eq system.dadosCaracteristicas.misticismo "d6")}}selected{{/if}}>d6</option>
            <option value="d8" {{#if (eq system.dadosCaracteristicas.misticismo "d8")}}selected{{/if}}>d8</option>
            <option value="d10" {{#if (eq system.dadosCaracteristicas.misticismo "d10")}}selected{{/if}}>d10</option>
            <option value="d12" {{#if (eq system.dadosCaracteristicas.misticismo "d12")}}selected{{/if}}>d12</option>
          </select>
          <button type="button" class="cyd-btn-atributo-pnj" data-action="tiradaAtributoPnj" data-caracteristica="misticismo" data-dado="{{system.dadosCaracteristicas.misticismo}}" data-tooltip="Tirar atributo Misticismo directamente">
            🎲 Tirar
          </button>
        </div>
      </div>

      <div class="cyd-texto-vacio" style="font-size: 0.72rem; margin-top: 6px;">
        💡 Los PNJ pueden usar atributos directamente sin cartas.
      </div>
    </aside>

    {{!-- COLUMNA DERECHA: RECURSOS, MOVIMIENTO, MAZO DE JEFE ================= --}}
    <section class="cyd-contenido-derecha">

      {{!-- Recursos vitales ================= --}}
      <div class="cyd-recursos-barra" style="grid-template-columns: repeat(4, 1fr); gap: 6px;">
        <div class="cyd-recurso-caja" data-tooltip="Base: {{system.salud.max}} + Físico: {{system.salud.bonoFisico}} + Bonos: {{system.salud.bonoOtros}} = {{system.salud.maxTotal}}">
          <span>❤️ Salud</span>
          <div class="cyd-recurso-inputs">
            <input type="number" name="system.salud.value" value="{{system.salud.value}}" />
            <span>/ {{system.salud.maxTotal}}</span>
            <small data-tooltip="Salud Base">(Base: <input type="number" name="system.salud.max" value="{{system.salud.max}}" style="width:34px;" />)</small>
          </div>
        </div>

        <div class="cyd-recurso-caja" data-tooltip="Defensa Base: {{system.defensa}} | Bono Equipo: +{{system.bonificadorDefensa}}">
          <span>🛡️ Defensa</span>
          <div class="cyd-recurso-inputs">
            <input type="number" name="system.defensa" value="{{system.defensa}}" min="0" />
            <span>({{system.defensaTotal}})</span>
          </div>
        </div>

        <div class="cyd-recurso-caja">
          <span>⚡ Cansancio</span>
          <div class="cyd-recurso-inputs">
            <input type="number" name="system.cansancio.value" value="{{system.cansancio.value}}" />
            <span>/ {{system.cansancio.maxTotal}}</span>
          </div>
        </div>

        {{#if tieneMazoJefe}}
          <div class="cyd-recurso-caja">
            <span>✋ Mano Jefe</span>
            <div class="cyd-recurso-inputs">
              <strong>{{contadoresPilas.manoActual}} / {{system.limiteMano}}</strong>
            </div>
          </div>
        {{/if}}
      </div>

      {{!-- ================= 3. MOVIMIENTO Y TAMAÑO ================= --}}
  <section class="cyd-panel cyd-panel-movimiento-tamano">
    <div class="cyd-cabecera-seccion">
      <h3>🏃 Movimiento y Tamaño</h3>
    </div>
    <div class="cyd-recursos-barra" style="grid-template-columns: repeat(2, 1fr); gap: 8px;">
      <div class="cyd-recurso-caja" data-tooltip="Base de Movimiento editable en esta ficha. El Total se calcula automáticamente: Base + (Físico Total × 5) metros">
        <span class="cyd-recurso-titulo">🏃 Movimiento</span>
        <div class="cyd-recurso-inputs">
          <input type="number" name="system.movimiento.base" value="{{system.movimiento.base}}" min="0" style="width: 60px;" />
          <span>/ {{system.movimiento.max}} m</span>
        </div>
      </div>
      <div class="cyd-recurso-caja" data-tooltip="Categoría de tamaño de la criatura">
        <span class="cyd-recurso-titulo">📏 Tamaño</span>
        <select name="system.categoriaTamano" style="width: 100%;">
          <option value="Diminuto" {{#if (eq system.categoriaTamano "Diminuto")}}selected{{/if}}>Diminuto</option>
          <option value="Pequeño" {{#if (eq system.categoriaTamano "Pequeño")}}selected{{/if}}>Pequeño</option>
          <option value="Mediano" {{#if (eq system.categoriaTamano "Mediano")}}selected{{/if}}>Mediano</option>
          <option value="Grande" {{#if (eq system.categoriaTamano "Grande")}}selected{{/if}}>Grande</option>
          <option value="Enorme" {{#if (eq system.categoriaTamano "Enorme")}}selected{{/if}}>Enorme</option>
        </select>
      </div>
    </div>
  </section>

    {{!-- 3. ZONA DE MAZO DE JEFE (SOLO SI ESTÁ ACTIVO; SIN TRINKETS) --}}
    {{#if tieneMazoJefe}}
      <section class="cyd-panel-controles">
        <div class="cyd-acciones-turno cyd-cols-3">
          <button type="button" data-action="robarTurno">🎴 Robar Turno (Jefe)</button>
          <button type="button" data-action="finCombate">🔄 Fin Combate (Barajar Todo)</button>
          <button type="button" data-action="descansar">🏕️ Reiniciar / Descansar</button>
        </div>

        <div class="cyd-resumen-pilas">
          <span class="cyd-chip-pila" data-action="abrirPila" data-pila="mazo" data-tooltip="Abrir Mazo del Jefe">
            📚 Mazo: <strong>{{contadoresPilas.mazoDisponibles}}/{{contadoresPilas.mazoTotal}}</strong>
          </span>
          <button type="button" class="cyd-btn-mini" data-action="crearCartaEnMazo">+ Carta</button>
          {{#if (eq contadoresPilas.mazoTotal 0)}}
            <button type="button" class="cyd-btn-mini" data-action="generarMazoBase">🎁 Mazo Base</button>
          {{/if}}
          <span class="cyd-chip-pila" data-action="abrirPila" data-pila="mano" data-tooltip="Abrir Mano del Jefe">
            ✋ Mano: <strong>{{contadoresPilas.manoActual}}/{{system.limiteMano}}</strong>
          </span>
          <span class="cyd-chip-pila" data-action="abrirPila" data-pila="descarte" data-tooltip="Abrir Descarte del Jefe">
            📥 Descarte: <strong>{{contadoresPilas.descarteActual}}</strong>
          </span>
          <span class="cyd-chip-pila" data-action="abrirPila" data-pila="quemadas" data-tooltip="Abrir Quemadas del Jefe">
            🔥 Quemadas: <strong>{{contadoresPilas.quemadasActual}}</strong>
          </span>
        </div>
      </section>

      <section class="cyd-panel-mano">
        <div class="cyd-cabecera-seccion">
          <h3>✋ Mano del Jefe ({{contadoresPilas.manoActual}} / {{system.limiteMano}})</h3>
          <small>🎯 Pulsa <strong>T</strong> sobre un PJ antes de jugar una carta de ataque</small>
        </div>

        {{#if cartasEnMano.length}}
          <div class="cyd-grid-cartas">
            {{#each cartasEnMano as |carta|}}
              <article class="cyd-carta-item">
                <header class="cyd-carta-cabecera">
                  <span class="cyd-carta-titulo">{{carta.nombre}}</span>
                  <span class="cyd-carta-dado">{{carta.cantidadDados}}{{carta.tipoDado}}</span>
                </header>
                <div class="cyd-carta-subtitulo">
                  <span>Palo: <strong>{{carta.paloAbrev}}</strong> ({{carta.caracteristica}})</span>
                  {{#if carta.seQuema}}<span>🔥 Se Quema</span>{{/if}}
                </div>
                <div class="cyd-carta-efecto">{{{carta.efecto}}}</div>
                <footer class="cyd-carta-acciones">
                  <button type="button" class="cyd-btn-jugar" data-action="jugarCarta" data-carta-id="{{carta.id}}" data-modo="usar">
                    🎲 Usar
                  </button>
                  <button type="button" class="cyd-btn-descartar" data-action="descartarCarta" data-carta-id="{{carta.id}}" data-tooltip="Descartar sin tirar (se anuncia en el chat)">
                    📥 Descartar
                  </button>
                  <button type="button" class="cyd-btn-quemar" data-action="quemarCarta" data-carta-id="{{carta.id}}" data-tooltip="Quemar sin tirar (se anuncia en el chat)">
                    🔥 Quemar
                  </button>
                  <button type="button" class="cyd-btn-jugar-quemar" data-action="jugarCarta" data-carta-id="{{carta.id}}" data-modo="usar-y-quemar">
                    🎲🔥 Usar y Quemar
                  </button>
                </footer>
              </article>
            {{/each}}
          </div>
        {{else}}
          <p class="cyd-texto-vacio">Mano vacía. Pulsa "🎴 Robar Turno (Jefe)" para robar cartas.</p>
        {{/if}}
      </section>
    {{/if}}

    {{!-- 4. PANELES SEPARADOS: HABILIDADES Y EQUIPO --}}
    <div class="cyd-dos-columnas">

      <section class="cyd-panel">
        <div class="cyd-cabecera-seccion">
          <h3>🐾 Ataques y Habilidades</h3>
          <button type="button" class="cyd-btn-mini" data-action="crearItemPnj" data-tipo="habilidad">+ Habilidad</button>
        </div>

        {{#if habilidades.length}}
          <div class="cyd-lista-items">
            {{#each habilidades as |hab|}}
              <div class="cyd-fila-item" data-tooltip="{{hab.system.descripcion}}">
                <div class="cyd-fila-item-info">
                  <strong class="cyd-link-item" data-action="editarItem" data-item-id="{{hab.id}}">{{hab.name}}</strong>
                  <small>{{hab.system.caracteristica}} ({{hab.system.tipoDado}}{{#if hab.system.bonoTirada}}+{{hab.system.bonoTirada}}{{/if}})</small>
                </div>
                <div class="cyd-fila-item-acciones">
                  <button type="button" class="cyd-btn-mini" data-action="usarHabilidad" data-item-id="{{hab.id}}">
                    {{#if hab.system.esAtaque}}⚔️{{else}}⚡{{/if}}
                  </button>
                  <button type="button" class="cyd-btn-mini" data-action="eliminarItem" data-item-id="{{hab.id}}">✕</button>
                </div>
              </div>
            {{/each}}
          </div>
        {{else}}
          <p class="cyd-texto-vacio">Sin habilidades registradas.</p>
        {{/if}}
      </section>

      <section class="cyd-panel">
        <div class="cyd-cabecera-seccion">
          <h3>🎒 Equipo y Objetos</h3>
          <button type="button" class="cyd-btn-mini" data-action="crearItemPnj" data-tipo="objeto">+ Objeto</button>
        </div>

        {{#if objetos.length}}
          <div class="cyd-lista-items">
            {{#each objetos as |obj|}}
              <div class="cyd-fila-item {{#if obj.system.equipado}}cyd-item-equipado{{/if}}" data-tooltip="{{obj.system.descripcion}}">
                <div class="cyd-fila-item-info">
                  <button type="button" class="cyd-btn-mini" data-action="alternarEquipado" data-item-id="{{obj.id}}">
                    {{#if obj.system.equipado}}🛡️{{else}}⚪{{/if}}
                  </button>
                  <strong class="cyd-link-item" data-action="editarItem" data-item-id="{{obj.id}}">{{obj.name}}</strong>
                  <small>
                    {{#if obj.system.bonificadores.defensa}}(🛡️+{{obj.system.bonificadores.defensa}}){{/if}}
                    {{#if obj.system.bonificadores.saludMax}}(❤️+{{obj.system.bonificadores.saludMax}}){{/if}}
                  </small>
                </div>
                <div class="cyd-fila-item-acciones">
                  <span class="cyd-tag-cantidad">x{{obj.system.cantidad}}</span>
                  <button type="button" class="cyd-btn-mini" data-action="eliminarItem" data-item-id="{{obj.id}}">✕</button>
                </div>
              </div>
            {{/each}}
          </div>
        {{else}}
          <p class="cyd-texto-vacio">Sin objetos ni armaduras.</p>
        {{/if}}
      </section>

    </div>

    {{!-- 5. NOTAS DEL MASTER --}}
    <section class="cyd-panel cyd-panel-flex">
      <div class="cyd-cabecera-seccion">
        <h3>📝 Comportamiento / Notas</h3>
      </div>
      <textarea name="system.biografia" rows="2" class="cyd-textarea">{{system.biografia}}</textarea>
    </section>

    </section>

  </div>

  </main>
</div>