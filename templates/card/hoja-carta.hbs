{{!--
  Plantilla del Editor Visual de Cartas (Acción y Trinket) en Foundry VTT v14.
  Iconografía (v0.9.0): solo iconos Font Awesome y símbolos tipográficos, sin emojis.
--}}
<div class="cyd-hoja-contenedor">
  <header class="cyd-cabecera">
    <div class="cyd-retrato">
      <img class="cyd-avatar" src="{{card.img}}" alt="{{card.name}}" data-action="verImagen" data-tooltip="Ver imagen a tamaño completo" />
      <div class="cyd-retrato-botones">
        {{#if retrato.puedeEditar}}
          <button type="button" class="cyd-btn-retrato" data-action="editarImagen" data-tooltip="Editar imagen" aria-label="Editar imagen"><i class="fa-solid fa-pen-to-square"></i></button>
        {{/if}}
      </div>
    </div>
    <div class="cyd-cabecera-principal">
      <div class="cyd-fila-titulo">
        <input type="text" name="name" value="{{name}}" class="cyd-nombre-actor" placeholder="Nombre de la Carta" />
        <span class="cyd-badge-nivel">
          {{#if esTrinket}}<i class="fa-solid fa-gem"></i> Trinket{{else}}<i class="fa-solid fa-diamond"></i> Acción{{/if}}
        </span>
      </div>
      <p class="cyd-subtitulo-cabecera">
        {{#if esTrinket}}
          Nivel <strong>{{system.nivel}}</strong> · entra en juego directamente, sin lanzar dados
        {{else}}
          Dado <strong>{{system.tipoDado}}</strong> · escalado con <strong>{{system.caracteristicaAsociada}}</strong>
        {{/if}}
      </p>
    </div>
  </header>

  <section class="cyd-panel-controles">
    <div class="cyd-cabecera-seccion">
      <h3><i class="fa-solid fa-sliders"></i> Propiedades</h3>
    </div>
    <div class="cyd-recursos-barra cyd-cols-3">
      {{#if esTrinket}}
        {{!-- Trinkets: sin Palo ni Número/Dado; su escala es su Nivel (v0.8.4) --}}
        <div class="cyd-recurso-caja" data-tooltip="Nivel del Trinket (los Trinkets no usan palo ni dado)">
          <span class="cyd-recurso-titulo"><i class="fa-solid fa-signal"></i> Nivel</span>
          <input type="number" name="system.nivel" min="1" value="{{system.nivel}}" />
        </div>
      {{else}}
        <div class="cyd-recurso-caja">
          <span class="cyd-recurso-titulo"><i class="fa-solid fa-diamond"></i> Palo</span>
          <select name="system.palo">
            <option value="espadas" {{#if (eq system.palo "espadas")}}selected{{/if}}>FISC · Físico</option>
            <option value="bastos" {{#if (eq system.palo "bastos")}}selected{{/if}}>CONS · Consciencia</option>
            <option value="oros" {{#if (eq system.palo "oros")}}selected{{/if}}>SOC · Social</option>
            <option value="copas" {{#if (eq system.palo "copas")}}selected{{/if}}>MIST · Misticismo</option>
          </select>
        </div>

        <div class="cyd-recurso-caja">
          <span class="cyd-recurso-titulo"><i class="fa-solid fa-dice-d20"></i> Valor · Dado</span>
          <select name="system.numero" data-dtype="Number">
            <option value="1" {{#if (eq system.numero 1)}}selected{{/if}}>1 · d4</option>
            <option value="2" {{#if (eq system.numero 2)}}selected{{/if}}>2 · d6</option>
            <option value="3" {{#if (eq system.numero 3)}}selected{{/if}}>3 · d8</option>
            <option value="4" {{#if (eq system.numero 4)}}selected{{/if}}>4 · d10</option>
            <option value="5" {{#if (eq system.numero 5)}}selected{{/if}}>5 · d12</option>
          </select>
        </div>
      {{/if}}

      {{#if esAccion}}
        <label class="cyd-recurso-caja cyd-check" data-tooltip="Al usarla, el diálogo «Realizar acción» propone por defecto un ataque.">
          <span class="cyd-recurso-titulo"><i class="fa-solid fa-crosshairs"></i> Es Ataque</span>
          <input type="checkbox" name="system.esAtaque" {{checked system.esAtaque}} />
        </label>
      {{/if}}
    </div>

    {{#if esAccion}}
      <div class="cyd-recursos-barra cyd-cols-2">
        <label class="cyd-recurso-caja cyd-check" data-tooltip="Al usarla va a Cartas Quemadas en vez de al Descarte (las cartas MIST se queman siempre).">
          <span class="cyd-recurso-titulo"><i class="fa-solid fa-fire"></i> Se quema al usarla</span>
          <input type="checkbox" name="system.seQuema" {{checked system.seQuema}} />
        </label>
      </div>
    {{/if}}
  </section>

  {{!-- Comportamiento de reglas del Trinket (v0.15.1): efecto de abalorio y Abalorio Eterno --}}
  {{#if reglasTrinket}}
    <section class="cyd-panel-controles">
      <div class="cyd-cabecera-seccion">
        <h3><i class="fa-solid fa-gem"></i> Reglas del Trinket</h3>
      </div>
      <div class="cyd-recursos-barra cyd-cols-2">
        <div class="cyd-recurso-caja" data-tooltip="Efecto automatizado que se aplica mientras el Trinket está En Juego.">
          <span class="cyd-recurso-titulo"><i class="fa-solid fa-gears"></i> Efecto de abalorio</span>
          <select name="flags.cartas-y-dados.abalorio">
            <option value="" {{#unless reglasTrinket.abalorio}}selected{{/unless}}>Ninguno (efecto narrativo)</option>
            {{#each reglasTrinket.opciones as |opcion|}}
              <option value="{{opcion.clave}}" {{#if opcion.seleccionado}}selected{{/if}}>{{opcion.nombre}} · {{opcion.clase}}</option>
            {{/each}}
          </select>
        </div>
        <label class="cyd-recurso-caja cyd-check" data-tooltip="Abalorio Eterno: solo puede estar En Juego o Quemado; empieza En Juego, sigue En Juego entre escenas y vuelve a estar En Juego al descansar.">
          <span class="cyd-recurso-titulo"><i class="fa-solid fa-infinity"></i> Eterno</span>
          <input type="checkbox" name="flags.cartas-y-dados.eterno" {{checked reglasTrinket.eterno}} />
        </label>
      </div>
      {{#if reglasTrinket.auto}}
        <p class="cyd-rasgo-auto"><i class="fa-solid fa-gears"></i> {{reglasTrinket.auto}}</p>
      {{/if}}
    </section>
  {{/if}}

  {{!-- Bloque de Automatización Mecánica --}}
  <section class="cyd-panel-controles">
    <div class="cyd-cabecera-seccion">
      <h3><i class="fa-solid fa-gears"></i> Efectos Automáticos al Jugar</h3>
    </div>
    <div class="cyd-recursos-barra">
      <div class="cyd-recurso-caja" data-tooltip="Se suma al resultado de los dados y al daño">
        <span class="cyd-recurso-titulo"><i class="fa-solid fa-plus-minus"></i> Bono Dado</span>
        <input type="number" name="system.automatizacion.bonoTirada" value="{{system.automatizacion.bonoTirada}}" />
      </div>
      <div class="cyd-recurso-caja" data-tooltip="Salud que recupera el jugador al usar la carta">
        <span class="cyd-recurso-titulo"><i class="fa-solid fa-heart-pulse"></i> Curación</span>
        <input type="number" name="system.automatizacion.curacion" value="{{system.automatizacion.curacion}}" min="0" />
      </div>
      <div class="cyd-recurso-caja" data-tooltip="Cartas adicionales que roba inmediatamente">
        <span class="cyd-recurso-titulo"><i class="fa-solid fa-clone"></i> Robar</span>
        <input type="number" name="system.automatizacion.robarCartas" value="{{system.automatizacion.robarCartas}}" min="0" />
      </div>
      <div class="cyd-recurso-caja" data-tooltip="Usa valores negativos (ej. -1) para aliviar Agotamiento">
        <span class="cyd-recurso-titulo"><i class="fa-solid fa-hourglass-half"></i> Agotamiento</span>
        <input type="number" name="system.automatizacion.cambioCansancio" value="{{system.automatizacion.cambioCansancio}}" />
      </div>
    </div>

    {{#if esTrinket}}
      <div class="cyd-recurso-caja cyd-check" data-tooltip="Se suma a la Defensa Total mientras el Trinket permanezca En Juego">
        <span class="cyd-recurso-titulo"><i class="fa-solid fa-shield-halved"></i> Bono a la Defensa mientras está En Juego</span>
        <input type="number" name="system.bonoDefensaEnJuego" value="{{system.bonoDefensaEnJuego}}" />
      </div>
    {{/if}}
  </section>

  {{#if esAccion}}
    <section class="cyd-panel-mano cyd-panel-texto">
      <div class="cyd-cabecera-seccion">
        <h3><i class="fa-solid fa-feather-pointed"></i> Efecto de la Acción</h3>
      </div>
      <textarea name="system.efecto" rows="4" class="cyd-textarea">{{system.efecto}}</textarea>
    </section>
  {{else}}
    <section class="cyd-panel-mano cyd-panel-texto">
      <div class="cyd-cabecera-seccion">
        <h3><i class="fa-solid fa-feather-pointed"></i> Efectos del Trinket</h3>
      </div>
      <div class="cyd-campo">
        <label><i class="fa-solid fa-infinity"></i> Efecto Permanente (Pasivo)</label>
        <textarea name="system.efectoPermanente" rows="2" class="cyd-textarea">{{system.efectoPermanente}}</textarea>
      </div>
      <div class="cyd-campo">
        <label><i class="fa-solid fa-circle-dot"></i> Efecto al Jugar (mientras está En Juego)</label>
        <textarea name="system.efectoAlJugar" rows="2" class="cyd-textarea">{{system.efectoAlJugar}}</textarea>
      </div>
    </section>
  {{/if}}
</div>
